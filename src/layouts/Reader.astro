---
// A use-case page or blog article, read inside the same desktop window as the rest of the site (menu bar, window,
// faceplates, Dock all come from Desktop.astro). The display shows the section label and the page's h1; everything
// else here is server HTML from the page's front matter and markdown body.
import Desktop from "./Desktop.astro";
import "../styles/reader.css";
import { download, version, requires } from "../data/site";
import ScheduledBadge from "../components/ScheduledBadge.astro";
import ExtLink from "../components/ExtLink.astro";
import { sections, pathOf, dateText, pageInfo, kindLabel, isLive, showDrafts, type Entry, type Section } from "../data/content";
import { orgNode, webPage, article, breadcrumbs, faqPage } from "../data/schema";

interface Props { entry: Entry; section: Section; headings: { depth: number; slug: string; text: string }[] }
const { entry, section, headings } = Astro.props;
const d = entry.data;
const sec = sections[section];
const path = pathOf(section, entry.id);
// the page's own share image (scripts/render-og-pages.py), 1200x630; also its Article image, so the two match
const ogImage = `/og/${entry.id}.png`;
// a draft is built only in dev and previews: it gets the "Scheduled for" badge and noindex
const scheduled = showDrafts && !isLive(entry);

// the table of contents lists the ## headings; with fewer than four it adds nothing
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 4;
const related = await Promise.all(d.related.map(async (p) => ({ path: p, ...(await pageInfo(p)) })));

const crumbs = [{ name: "Home", path: "/" }, { name: sec.label, path: sec.path }, { name: d.h1, path }];
const jsonLd = [
  section === "blog"
    ? article({ path, headline: d.h1, description: d.description, published: d.published, updated: d.updated, image: ogImage })
    : webPage({ path, name: d.h1, description: d.description, published: d.published, updated: d.updated }),
  breadcrumbs(crumbs),
  faqPage(d.faq),
  orgNode,
];
---
<Desktop title={d.title} description={d.description} page={section} headline={d.h1} jsonLd={jsonLd} ogImage={ogImage} noindex={scheduled}>
  <div class="content-inner reader">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href={sec.path}>{sec.label}</a></li>
        <li aria-current="page">{d.h1}</li>
      </ol>
    </nav>
    <p class="byline"><span class="kind">{kindLabel[d.kind]}</span> <span class="divider" aria-hidden="true"></span> Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{dateText(d.updated)}</time> · by <ExtLink href="https://n-uf.com">n-uf</ExtLink>{scheduled && <><span class="divider" aria-hidden="true"></span><ScheduledBadge date={d.published} /></>}</p>

    <div class="card takeaways">
      <h4>Key takeaways</h4>
      <ul>{d.takeaways.map((t) => <li>{t}</li>)}</ul>
    </div>

    <div class="reader-grid" data-toc={showToc ? "on" : "off"}>
      {showToc && (
        <nav class="card toc" aria-label="On this page">
          <h4>On this page</h4>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="main-col">
        <article class="card prose">
          <slot />
        </article>

        <div class="card faq-card">
          <h4>Questions people ask</h4>
          {d.faq.map(({ q, a }, i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
        </div>

        <div class="card related">
          <h4>Related</h4>
          <ul>
            {related.map((r) => <li><a href={r.path}><b>{r.title}</b><span>{r.description}</span></a></li>)}
          </ul>
        </div>

        {d.sources.length > 0 && (
          <div class="card sources">
            <h4>Sources</h4>
            <ul>
              {d.sources.map((s) => <li><ExtLink href={s.url}>{s.title}</ExtLink> <span class="chk">checked {dateText(s.checked)}</span></li>)}
            </ul>
          </div>
        )}

        <div class="card dl-card">
          <h4>Download</h4>
          <!-- the same key as on the Install page; on a computer that isn't a Mac it is the unlit "Mac only" key -->
          <div class="key-note dl-row">
            <ExtLink class="pill dl dim" href={download}><span class="dl-l">Download for Mac</span><span class="dl-na">Mac only</span></ExtLink>
            <span class="divider" aria-hidden="true"></span>
            <span class="note">cl_audit {version} · {requires} · free, source-available · <a href="/install/">Install steps</a></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Desktop>
