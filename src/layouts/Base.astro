---
import "../styles/app.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
}
const { title, description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#212121" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cl_audit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <ClientRouter fallback="swap" />
    <!-- cl_audit runs only on Macs with Apple silicon. Before the first paint, mark the page when the browser says it
         isn't on a Mac (an iPad says it is a Mac, but has a touch screen); Chrome and Edge can also tell an Intel Mac.
         CSS then shows the Download keys as unlit "Mac only" keys and the hero display gives the reason. -->
    <script is:inline>
      (function () {
        var w = window, root = document.documentElement;
        function apply() {
          root.classList.toggle("not-mac", w.__clSys !== "mac");
          root.dataset.sys = w.__clSys;
        }
        try {
          var d = navigator.userAgentData, p = (d && d.platform) || navigator.platform || "", ua = navigator.userAgent || "";
          var mac = /mac/i.test(p) || /Macintosh/.test(ua);
          if (mac && navigator.maxTouchPoints > 1) mac = false;
          w.__clSys = mac ? "mac" : "other";
          if (mac && d && d.getHighEntropyValues) {
            d.getHighEntropyValues(["architecture"]).then(function (v) {
              if (v.architecture === "x86") { w.__clSys = "intel"; apply(); document.dispatchEvent(new Event("cl:platform")); }
            }).catch(function () {});
          }
        } catch (e) { w.__clSys = "mac"; }
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
      // the panels' faceplate (standard, black or silver), chosen in the window's title bar; a per-browser convenience
      (function () {
        var w = window, root = document.documentElement, KEY = "cl_audit.face";
        try { w.__clFace = localStorage.getItem(KEY) || "std"; } catch (e) { w.__clFace = "std"; }
        function apply() {
          root.classList.toggle("face-black", w.__clFace === "black");
          root.classList.toggle("face-silver", w.__clFace === "silver");
        }
        w.__clSetFace = function (f) {
          w.__clFace = f === "black" || f === "silver" ? f : "std";
          try { localStorage.setItem(KEY, w.__clFace); } catch (e) {}
          apply();
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
