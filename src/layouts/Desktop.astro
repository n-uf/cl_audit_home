---
// The whole site is the cl_audit app on a Mac desktop: a menu bar, one app window and the Dock.
// The window's top-bar switch is the site navigation; each page is its own address and only the
// window's content changes (and scrolls).
import Base from "./Base.astro";
import Dock from "../components/Dock.astro";
import DesktopApps from "../components/DesktopApps.astro";
import TerminalApps from "../components/TerminalApps.astro";
import { repo, download, version } from "../data/site";

export type Page = "overview" | "dashboard" | "settings" | "install" | "faq" | "none";
// headline: the page title, shown lit in the top display window (it is the page's h1)
interface Props { title: string; description: string; page: Page; headline?: string; jsonLd?: object[] }
const { title, description, page, headline, jsonLd } = Astro.props;

const nav: [Page, string, string][] = [
  ["overview", "Overview", "/"], ["dashboard", "Demo dashboard", "/dashboard/"], ["settings", "Settings", "/settings/"],
  ["install", "Install", "/install/"], ["faq", "FAQ", "/faq/"],
];
const current = nav.find(([id]) => id === page)?.[1];
// the title's part after " · " is secondary: shown in a quieter style in the display
const [headMain, ...headRest] = (headline ?? "").split(" · ");
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="desk" data-page={page}>
    <header class="menubar" transition:persist="menubar">
      <a class="mb-brand" href="/"><img src="/favicon.png" alt="" width="16" height="16" />cl_audit</a>
      <nav class="mb-links" aria-label="Site">{nav.map(([, label, href]) => <a href={href}>{label}</a>)}</nav>
      <span class="spacer"></span>
      <a class:list={["mb-dl", { dim: page === "overview" || page === "install" }]} href={download} title={`cl_audit ${version} for Mac`}><span aria-hidden="true">↓ </span>Download for Mac</a>
      <span class="mb-na">Mac only</span>
      <a class="mb-gh" href={repo}>GitHub</a>
      <span class="mb-clock" aria-hidden="true"></span>
      <!-- phones: the faceplate keys live here, at the right end of the menu bar (the title bar's are hidden there) -->
      <span class="face-pick mb-face" role="group" aria-label="Faceplate">
        <button type="button" class="fk" data-face="std" aria-pressed="true">Std</button><button type="button" class="fk" data-face="black" aria-pressed="false">Black</button><button type="button" class="fk" data-face="silver" aria-pressed="false">Silver</button>
      </span>
    </header>

    <div class="appwin" transition:animate="none">
      <!-- the window's head: the title bar and the top strip (on phones an overlay over the content, see app.css) -->
      <div class="apphead">
      <div class="titlebar"><span class="lights" aria-hidden="true"><i></i><i></i><i></i></span><span class="tb-title">cl_audit</span>
        <!-- the panels' faceplate: the standard one, or a black or silver cassette-deck plate (remembered in this browser) -->
        <span class="face-pick" role="group" aria-label="Faceplate">
          <span class="lbl" aria-hidden="true">Face</span>
          <button type="button" class="fk" data-face="std" aria-pressed="true">Std</button><button type="button" class="fk" data-face="black" aria-pressed="false">Black</button><button type="button" class="fk" data-face="silver" aria-pressed="false">Silver</button>
        </span>
      </div>
      <!-- the top strip of the front panel: brand, the display window with the page title, the PAGE keys -->
      <div class="fascia">
        <a class="brand" href="/"><b>cl_audit</b><span>Usage audit for Claude profiles</span></a>
        {headline && <h1 class="disp page-disp"><em>{current ?? "404"}</em>{page === "overview" && <span class="lslot" aria-hidden="true"></span>}<span class="pd-t">{headMain}{headRest.length > 0 && <span class="pd-sub"> · {headRest.join(" · ")}</span>}</span>{page === "overview" && <span class="lalert" aria-hidden="true"></span>}</h1>}
        <div class="fascia-slot"><slot name="top" /></div>
        <nav class="plate pages" aria-label="Pages">
          <span class="lbl" aria-hidden="true">Page</span><span class="divider" aria-hidden="true"></span>
          {nav.map(([id, label, href]) => <a href={href} class:list={["key", "sm", { on: id === page }]} aria-current={id === page ? "page" : undefined}><span class="led" aria-hidden="true"></span>{label}</a>)}
        </nav>
      </div>
      </div>
      <main class="content" transition:animate="fade">
        <slot />
      </main>
      <!-- "What this does now" (Settings): an overlay that takes no layout space, bottom centre of the window -->
      <div class="whatnow" aria-live="polite" aria-atomic="true">
        <div class="whatnow-card" data-whatnow>
          <button type="button" class="wn-x" aria-label="Close" data-whatnow-close>×</button>
          <b class="wn-t"></b>
          <span class="wn-d"></span>
        </div>
      </div>
    </div>

    <DesktopApps />
    <TerminalApps />
    <Dock />
  </div>
</Base>

<script>
  import { applyPrefs } from "../data/prefs";
  import { initCards } from "../data/cardState";
  import { initWhatNow } from "../data/whatNow";
  import { initDownloadFocus } from "../data/downloadFocus";
  import { initDockLamps } from "../data/dockLamps";
  // On a computer that isn't a Mac (see Base.astro) the Download keys can't be pressed: no link, out of the tab order.
  const lockDownloads = () => {
    const off = document.documentElement.classList.contains("not-mac");
    document.querySelectorAll<HTMLAnchorElement>("a.pill.dl, a.mb-dl").forEach((a) => {
      if (off && a.hasAttribute("href")) { a.dataset.href = a.getAttribute("href")!; a.removeAttribute("href"); a.setAttribute("aria-disabled", "true"); }
      if (!off && a.dataset.href) { a.setAttribute("href", a.dataset.href); a.removeAttribute("aria-disabled"); }
    });
  };
  document.addEventListener("astro:page-load", () => { applyPrefs(); initCards(); initWhatNow(); initDownloadFocus(); lockDownloads(); initDockLamps(); });
  document.addEventListener("cl:platform", lockDownloads);

  // The faceplate switch: shows which one is on and changes it (Base.astro applies the saved one before the first paint).
  const showFace = () => {
    const face = (window as any).__clFace || "std";
    document.querySelectorAll<HTMLButtonElement>(".fk").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.face === face)));
  };
  document.addEventListener("astro:page-load", showFace);
  document.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".fk");
    if (!b) return;
    (window as any).__clSetFace?.(b.dataset.face);
    showFace();
  });

  // Phones (upright or on their side): the window's head (title bar, brand, display, PAGE keys) lies over the content, which scrolls under it
  // (.desk.ovl; until it is measured the head sits in the normal flow, in the same place). Scrolling down slides
  // the menu bar, title bar and brand away and leaves the display and the PAGE keys at the top (.desk.pin);
  // it stays compact while scrolling up, and only reaching the top slides them back. Only moved, never resized, so the scroll stays smooth.
  const phone = matchMedia("(max-width: 600px), (max-height: 500px)");   // a phone upright or on its side (as in app.css)
  let headSeen: ResizeObserver | undefined;
  const initPin = () => {
    headSeen?.disconnect();
    const desk = document.querySelector<HTMLElement>(".desk");
    const content = desk?.querySelector<HTMLElement>(".content");
    const head = desk?.querySelector<HTMLElement>(".apphead");
    if (!desk || !content || !head) return;
    const MENU = 28;   // the menu bar's height, which the head makes room for in the overlay
    const overlay = () => {
      if (!phone.matches) { desk.classList.remove("ovl", "pin"); return; }
      const h = head.offsetHeight + (desk.classList.contains("ovl") ? 0 : MENU);
      desk.style.setProperty("--head-h", `${h}px`);
      desk.classList.add("ovl");
    };
    overlay();
    headSeen = new ResizeObserver(() => { if (desk.classList.contains("ovl")) desk.style.setProperty("--head-h", `${head.offsetHeight}px`); });
    headSeen.observe(head);
    phone.onchange = () => { overlay(); };
    let lastY = content.scrollTop;
    const pin = (on: boolean) => {
      if (on === desk.classList.contains("pin")) return;
      if (on) {
        const disp = head.querySelector<HTMLElement>(".page-disp");
        if (!disp) return;
        // the head moves up so that the display sits 10 px under the top of the screen
        desk.style.setProperty("--pin-shift", `${disp.getBoundingClientRect().top - head.getBoundingClientRect().top - 10}px`);
      }
      desk.classList.toggle("pin", on);
    };
    content.addEventListener("scroll", () => {
      const y = content.scrollTop;
      if (!desk.classList.contains("ovl")) { lastY = y; return; }
      if (y < 12) pin(false);   // back at the top: the whole head again
      else if (y > lastY + 6 && y > 40) pin(true);   // scrolling up keeps it compact
      if (y < 12 || Math.abs(y - lastY) > 6) lastY = y;
    }, { passive: true });
    // a key reached with the keyboard while hidden brings the head back
    desk.addEventListener("focusin", (e) => {
      if ((e.target as HTMLElement).closest(".menubar, .titlebar, .brand")) pin(false);
    });
  };
  document.addEventListener("astro:page-load", initPin);

  // The menu bar clock, like the Mac's.
  const tick = () => {
    const el = document.querySelector<HTMLElement>(".mb-clock");
    if (!el) return;
    const d = new Date();
    // in the visitor's own date and time format, as their Mac shows it (e.g. "Sat 24. Oct  20:50")
    el.textContent = d.toLocaleDateString(undefined, { weekday: "short", day: "numeric", month: "short" }).replace(/,/g, "") +
      "  " + d.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
  };
  tick();
  setInterval(tick, 20000);
</script>
