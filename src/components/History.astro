---
// "Usage history" as the app draws it: heatmap, tokens chart, where it goes, legend. The Show chips in the
// top bar re-draw it in the browser for the selected profiles (see dashboard.astro).
import { accounts, type Range } from "../data/demo";
import { rangeHTML, sharesHTML, totalsHTML } from "../data/historyView";

const kinds: Range[] = ["24h", "7d", "30d"];
---
<div class="history" id="history">
  <!-- one line, as the app: the title, which charts to show (a key each, latched while shown), the totals in a
       display window and the period as three keys; two lines when narrow -->
  <div class="hist-head hhead">
    <h3>Usage history</h3>
    <span class="keys" role="group" aria-label="Charts shown">
      <button type="button" class="key k lt" data-chart-key="heat" aria-pressed="true">When you use Claude</button>
      <button type="button" class="key k lt" data-chart-key="tokens" aria-pressed="true"><span data-tokens-title>Tokens per day</span></button>
      <button type="button" class="key k lt" data-chart-key="shares" aria-pressed="true">Where it goes</button>
    </span>
    <span class="grow"></span>
    {kinds.map((k) => <span class="hist-total disp h26" data-range={k} set:html={totalsHTML(k)} />)}
    <span class="strip26" role="tablist" aria-label="Period">
      <button type="button" class="key k" data-pick="24h">24 h</button>
      <button type="button" class="key k lt" data-pick="7d">7 d</button>
      <button type="button" class="key k" data-pick="30d">30 d</button>
    </span>
  </div>
  <p class="no-charts sub" hidden>All charts are hidden; pick one above.</p>

  {kinds.map((k) => <div class="range-block" data-range={k} set:html={rangeHTML(k)} />)}

  <div class="chart-card" data-chart="shares">
    <div class="cc-head"><b>Where it goes</b><span>share of tokens in the period</span></div>
    {kinds.map((k) => <div class="shares range-shares" data-range={k} set:html={sharesHTML(k)} />)}
  </div>

  <div class="legend sub">
    {accounts.map((a) => <span class="legend-item" data-account={a.id}><i style={`background:${a.hex}`} />{a.name}</span>)}
    <span class="spacer"></span>
    <span class="hide-sm">From the session files on this Mac (terminal, desktop Code tab, VS Code, SDK apps).</span>
  </div>
</div>
