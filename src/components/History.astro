---
// "Usage history" as the app draws it: heatmap, tokens chart, where it goes, legend. The Show chips in the
// top bar re-draw it in the browser for the selected profiles (see dashboard.astro).
import { accounts, type Range } from "../data/demo";
import { rangeHTML, sharesHTML, totalsText } from "../data/historyView";

const kinds: Range[] = ["24h", "7d", "30d"];
---
<div class="history" id="history">
  <div class="hist-head">
    <h3>Usage history</h3>
    <span class="spacer"></span>
    {kinds.map((k) => <span class="hist-total sub" data-range={k}>{totalsText(k)}</span>)}
    <span class="switch range-picker" role="tablist" aria-label="Period">
      <button type="button" data-pick="24h">24 h</button>
      <button type="button" data-pick="7d" class="on">7 d</button>
      <button type="button" data-pick="30d">30 d</button>
    </span>
  </div>

  {kinds.map((k) => <div class="range-block" data-range={k} set:html={rangeHTML(k)} />)}

  <div class="chart-card">
    <div class="cc-head"><b>Where it goes</b><span>share of tokens in the period</span></div>
    {kinds.map((k) => <div class="shares range-shares" data-range={k} set:html={sharesHTML(k)} />)}
  </div>

  <div class="legend sub">
    {accounts.map((a) => <span class="legend-item" data-account={a.id}><i style={`background:${a.hex}`} />{a.name}</span>)}
    <span class="spacer"></span>
    <span class="hide-sm">From the session files on this Mac (terminal, desktop Code tab, VS Code, SDK apps).</span>
  </div>
</div>
