---
// A macOS Dock with the cl_audit icons. Like the app: click an account icon for a quick look at its
// limits, click the cl_audit icon for the launcher.
import Row from "./Row.astro";
import Limit from "./Limit.astro";
import { accounts } from "../data/demo";
---
<nav class="dock-bar" aria-label="cl_audit in the Dock" transition:persist="dock">
  <div class="dock">
    <button type="button" class="dock-item" data-pop="launcher" aria-label="cl_audit: open the launcher">
      <img src="/img/app-icon.png" alt="" width="56" height="56" /><span class="tip">cl_audit</span><span class="run"></span>
    </button>
    <span class="sep"></span>
    {accounts.map((a) => (<>
      <button type="button" class="dock-item" data-open-desktop={a.id} aria-label={`Claude desktop app for the ${a.name} account`}>
        <span class="app-tile" aria-hidden="true"></span><span class="tip">Claude desktop app — {a.name}</span><span class="run"></span>
      </button>
      <button type="button" class="dock-item" data-pop={a.id} aria-label={`cl_audit ${a.name}: ${a.five}% of the 5-hour session limit, ${a.week}% of the weekly limit`}>
        <img src={a.icon} alt="" width="56" height="56" /><span class="tip">cl_audit {a.name}</span><span class="run"></span>
      </button>
    </>))}
  </div>

  <div class="pop palette" data-popup="launcher" hidden>
    <div class="search">⌕ <span>Open Claude for…</span><span class="kbd">⌘1–3</span></div>
    {accounts.map((a, i) => <Row id={a.id} icon={a.icon} name={a.name} color={a.color} five={a.five} week={a.week} key={`⌘${i + 1}`} sel={i === 0} open={i < 2} />)}
    <a class="dash-card" href="/dashboard/">
      <span class="spark" aria-hidden="true">{[8, 15, 14, 11, 20, 17, 4].map((h, i) => <span><i style={`height:${h}px;background:var(--teal)`} /><i style={`height:${[4, 7, 6, 5, 6, 6, 2][i]}px;background:var(--orange)`} /></span>)}</span>
      <span style="flex:1;min-width:0"><b style="font-size:14px">Dashboard</b><br /><span class="sub" style="font-size:12px">usage history · last 7 days</span></span>
      <span class="kbd">⌘D</span><span class="sub">›</span>
    </a>
    <div class="foot"><span>click or ↩ desktop app · ⌘↩ Terminal</span><span>⚙︎</span></div>
  </div>

  {accounts.map((a) => (
    <div class="pop peek" data-popup={a.id} hidden>
      <div class="peek-head"><span class="dot" style={`background:${a.color}`} /><b>Claude {a.name}</b><span class="plan">{a.plan}</span></div>
      <Limit title="5-hour" when={a.fiveWhen} p={a.five} />
      <Limit title="Week" when={a.weekWhen} p={a.week} />
      <div class="sub peek-foot">Opening Claude {a.name}…</div>
    </div>
  ))}
</nav>

<script>
  const bar = document.querySelector<HTMLElement>(".dock-bar")!;
  let open: HTMLElement | null = null;
  const close = () => { open?.setAttribute("hidden", ""); open = null; };
  bar.querySelectorAll<HTMLButtonElement>("[data-pop]").forEach((b) =>
    b.addEventListener("click", (e) => {
      e.stopPropagation();
      const pop = bar.querySelector<HTMLElement>(`[data-popup="${b.dataset.pop}"]`)!;
      if (open === pop) return close();
      close();
      pop.removeAttribute("hidden");
      const r = b.getBoundingClientRect(), w = pop.offsetWidth;
      pop.style.left = `${Math.max(8, Math.min(window.innerWidth - w - 8, r.left + r.width / 2 - w / 2))}px`;
      open = pop;
      // Like the app: a click shows the usage for a moment, then opens that account's Claude desktop app.
      const id = b.dataset.pop!;
      if (id !== "launcher") setTimeout(() => { if (open === pop) { close(); (window as any).clOpenDesktop?.(id); } }, 1400);
    }),
  );
  document.addEventListener("click", (e) => { if (open && !open.contains(e.target as Node)) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  bar.querySelector(".pop.palette .dash-card")?.addEventListener("click", close);
  document.addEventListener("astro:before-swap", close);
  document.addEventListener("cl:close-pops", close);
</script>
