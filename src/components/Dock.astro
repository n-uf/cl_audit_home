---
// A macOS Dock with the cl_audit icons. Like the app: click an account icon for a quick look at its
// limits, a Claude tile for its desktop app, the cl_audit icon to bring cl_audit to the front.
import { panelHTML, type Design } from "../data/panelView";
import { accounts } from "../data/demo";
---
<nav class="dock-bar" aria-label="cl_audit in the Dock" transition:persist="dock">
  <div class="dock">
    <button type="button" class="dock-item" data-front-app aria-label="cl_audit: bring it to the front">
      <img src="/img/app-icon.png" alt="" width="56" height="56" /><span class="tip">cl_audit</span><span class="run"></span>
    </button>
    <span class="sep"></span>
    {accounts.map((a) => (<>
      <button type="button" class="dock-item" data-open-desktop={a.id} aria-label={`Claude desktop app for the ${a.name} account`}>
        <span class="app-tile" aria-hidden="true"></span><span class="tip">Claude desktop app — {a.name}</span><span class="run"></span>
      </button>
      <button type="button" class="dock-item" data-pop={a.id} aria-label={`cl_audit ${a.name}: ${a.five}% of the 5-hour session limit, ${a.week}% of the weekly limit`}>
        <img src={a.icon} data-acc-icon={a.id} alt="" width="56" height="56" /><span class="tip">cl_audit {a.name}</span><span class="run"></span>
      </button>
    </>))}
  </div>


  {accounts.map((a) => (
    <div class="pop peek" data-popup={a.id} hidden set:html={panelHTML(a.id, "segments", { large: false })} />
  ))}
</nav>

<script>
  import { panelHTML, type Design } from "../data/panelView";
  import { loadPrefs } from "../data/prefs";
  const bar = document.querySelector<HTMLElement>(".dock-bar")!;
  let open: HTMLElement | null = null;
  let timer = 0;
  const close = () => { clearTimeout(timer); open?.setAttribute("hidden", ""); open = null; };
  // A peek hides itself after the account's "Show usage for" time (3 s by default); it waits while the pointer is over it.
  const autoHide = (ms: number) => { clearTimeout(timer); timer = window.setTimeout(() => { if (open && !open.matches(":hover")) close(); else autoHide(ms); }, ms); };
  // cl_audit's own icon: bring it to the front, like clicking a running app (closes other windows and pop-ups).
  bar.querySelector<HTMLButtonElement>("[data-front-app]")?.addEventListener("click", (e) => {
    e.stopPropagation();
    (window as any).clCloseWins?.();
    close();
  });
  bar.querySelectorAll<HTMLButtonElement>("[data-pop]").forEach((b) =>
    b.addEventListener("click", (e) => {
      e.stopPropagation();
      const pop = bar.querySelector<HTMLElement>(`[data-popup="${b.dataset.pop}"]`)!;
      // the compact panel, in the design chosen for this account in Settings
      const pr = loadPrefs()[b.dataset.pop as "home"];
      pop.innerHTML = panelHTML(b.dataset.pop as "home", pr.panel as Design, { large: false, name: pr.name });
      if (open === pop) return close();
      close();
      pop.removeAttribute("hidden");
      const r = b.getBoundingClientRect(), w = pop.offsetWidth;
      pop.style.left = `${Math.max(8, Math.min(window.innerWidth - w - 8, r.left + r.width / 2 - w / 2))}px`;
      open = pop;
      autoHide(Math.round(pr.peek * 1000));
    }),
  );
  document.addEventListener("click", (e) => { if (open && !open.contains(e.target as Node)) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  document.addEventListener("astro:before-swap", close);
  document.addEventListener("cl:close-pops", close);
</script>
