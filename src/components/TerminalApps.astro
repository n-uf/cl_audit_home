---
// What "Terminal" opens: Terminal running Claude Code for that account, exactly as cl_audit starts it
// (its CLAUDE_CONFIG_DIR, then claude), covering the window's content area. It plays a short exchange,
// then leaves a prompt you can type into, with cl_audit's own status line underneath.
// Deliberately not Claude Code's start screen.
import { accounts, chats } from "../data/demo";
---
<div class="terms" transition:persist="terms">
  {accounts.map((a, i) => {
    const c = chats[a.id].code;
    const setup = i === 0 ? "unset CLAUDE_CONFIG_DIR" : `export CLAUDE_CONFIG_DIR=${a.dir}`;
    return (
      <section class="term deskwin" data-terminal={a.id} hidden aria-label={`Terminal running Claude Code for the ${a.name} account (illustration)`}>
        <div class="term-bar">
          <span class="lights"><button type="button" class="close" data-close aria-label="Close"></button><i></i><i></i></span>
          <span class="term-title">{a.name} — claude — 80×24</span>
        </div>
        <div class="term-body" data-log data-script={JSON.stringify({ cmds: [setup, "claude"], ask: c.ask, steps: c.steps, done: c.done })}>
          <div class="term-signed" hidden><span class="term-dim">Claude Code · signed in as </span><span class="email term-dim">{a.email}</span><span class="term-dim"> · {a.plan} plan</span></div>
        </div>
        <form class="term-prompt" data-term-form hidden>
          <span>&gt;</span><input type="text" autocomplete="off" aria-label="Message to Claude Code" />
        </form>
        <div class="term-status" hidden>5h {a.five}% · wk {a.week}%</div>
      </section>
    );
  })}
</div>

<script>
  const w_ = window as any;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const line = (log: HTMLElement, text: string, cls = "") => {
    const d = document.createElement("div");
    d.className = "term-line " + cls; d.textContent = text;
    log.append(d); log.scrollTop = log.scrollHeight;
    return d;
  };
  const typeInto = async (el: HTMLElement, text: string, fast: boolean) => {
    if (fast) { el.textContent += text; return; }
    for (const ch of text) { el.textContent += ch; await wait(26); }
  };

  const play = async (term: HTMLElement) => {
    if (term.dataset.played) return;
    term.dataset.played = "1";
    const log = term.querySelector<HTMLElement>("[data-log]")!;
    const s = JSON.parse(log.dataset.script || "{}");
    const fast = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const signed = log.querySelector<HTMLElement>(".term-signed")!;
    for (const cmd of s.cmds as string[]) {
      const l = line(log, "~ % ");
      log.insertBefore(l, signed);
      await wait(fast ? 0 : 200);
      await typeInto(l, cmd, fast);
      await wait(fast ? 0 : 300);
    }
    signed.hidden = false;
    log.append(signed);
    await wait(fast ? 0 : 500);
    const ask = line(log, "> ", "term-you");
    await typeInto(ask, s.ask, fast);
    for (const step of s.steps as string[]) { await wait(fast ? 0 : 650); line(log, "  · " + step, "term-dim"); }
    await wait(fast ? 0 : 600);
    line(log, s.done, "term-done");
    term.querySelector<HTMLElement>("[data-term-form]")!.hidden = false;
    term.querySelector<HTMLElement>(".term-status")!.hidden = false;
  };

  w_.clOpenTerminal = (id: string) => {
    const t = document.querySelector<HTMLElement>(`.term[data-terminal="${id}"]`);
    if (!t) return;
    w_.clOpenWin?.(t);
    play(t);
  };
  document.addEventListener("click", (e) => {
    const opener = (e.target as HTMLElement).closest<HTMLElement>("[data-open-terminal]");
    if (opener?.dataset.openTerminal) w_.clOpenTerminal(opener.dataset.openTerminal);
  });
  // Typing at the prompt: it's echoed, with a note that this is a demo.
  document.addEventListener("submit", (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>("[data-term-form]");
    if (!form) return;
    e.preventDefault();
    const input = form.querySelector("input")!;
    const text = input.value.trim();
    if (!text) return;
    const log = form.parentElement!.querySelector<HTMLElement>("[data-log]")!;
    line(log, "> " + text, "term-you");
    input.value = "";
    setTimeout(() => line(log, "  This Terminal is a demo, so nothing runs. With cl_audit installed, Claude Code runs here for this account.", "term-dim"), 400);
  });
</script>
