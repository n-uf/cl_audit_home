---
// The Switch page, as the app's SwitchPage.swift draws it (26.11.18, "one-folder switching"), in place of the profile's
// settings. A switch happens in the profile's own folder: the Claude window closes, a backup is made, the Code-tab
// sessions and scheduled tasks move to the other account, then Claude Code's own sign-in opens in Terminal for the folder
// and cl_audit watches it for up to 10 minutes. Two columns: Accounts (Now, To: standby accounts show no limits), then
// What changes (What changed once it ran) and Steps. The demo switches "work" (switchDemo.ts runs it with sample
// timings, and shows the cases it can meet when something goes wrong). Sample data only.
import { accounts, standby, offerOrder, shortName } from "../data/demo";

const a = accounts.find((x) => x.id === "work")!;
const first = shortName(offerOrder(standby.work)[0].email);
---
<section class="sw-page" data-sw-page hidden aria-label="Switch account">
  <div class="sw-head"><h3 data-sw-head>Switch Claude {a.name} to {first}</h3></div>
  <!-- the line at the top while it runs, when it's done or when something went wrong: a display and the keys out -->
  <div class="sw-run" data-sw-run hidden></div>
  <!-- demo only: the cases a switch can meet when something goes wrong -->
  <div class="sw-demo" data-sw-demo><span class="sub">Demo: what can go wrong</span>
    <span class="switch small-switch" role="group" aria-label="What can go wrong">
      <button type="button" data-sw-fail="window">Window won't close</button><button type="button" data-sw-fail="wrong">Wrong account</button><button type="button" data-sw-fail="timeout">No sign-in in 10 min</button><button type="button" data-sw-fail="half">Stopped half way</button><button type="button" data-sw-fail="cancel">Cancelled</button>
    </span></div>
  <div class="sw-cols">
    <div class="sw-col">
      <div class="card"><h4>Accounts <i class="idot" title={`The account ${a.name} works on now, with its limits, and the one it switches to. A standby account isn't read, so it shows no limits: only when it was last in use here.`}>i</i></h4>
        <div class="acc-flow" data-sw-acc-flow></div>
      </div>
    </div>
    <div class="sw-col">
      <div class="card sw-changes"><h4><span data-sw-changes-t>What changes</span> <i class="idot" title={`A switch moves ${a.name}'s Claude window sessions and scheduled tasks from the account in use to the other one, inside ${a.name}'s folder (with a backup first, a receipt and Undo), then signs Claude Code in again on that folder as the other account, in Terminal, finished in the browser. The Claude app's own sign-in is yours to change: cl_audit never signs anything in or out.`}>i</i></h4>
        <div data-sw-changes></div>
      </div>
      <div class="card" data-sw-stepscard><h4>Steps <i class="idot" title="When the switch moves sessions: the profile's Claude window closes, a backup is made, the sessions and scheduled tasks move (with a receipt, for Undo). Then Claude Code's own sign-in, and a check of the account it signed in. cl_audit never sees a password or a token. cl_audit itself never reads or writes Keychain items during a switch; Claude Code's own sign-in updates its own item.">i</i></h4>
        <ol class="sw-steps" data-sw-steps></ol>
        <div class="sw-keys" data-sw-keys></div>
        <p class="g-note sub sw-line" data-sw-line hidden></p>
      </div>
    </div>
  </div>
</section>
