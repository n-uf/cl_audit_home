---
// A profile's dashboard card, as the app draws it: icon and name, one row of two switches (its Claude
// window and its Dock icon; only the Dock icon one without a window; none for a usage only profile, which
// gets one display instead), both limits, and the keys. The switches work in the demo: the script in
// data/cardState.ts moves them, with a spinner, and keeps the state across pages.
import { cardLimitsHTML, fullLimit } from "../data/panelView";
import { cardKeysHTML, fullKeys, usualKeys } from "../data/cardKeys";
import { accounts, type AccountId } from "../data/demo";
import AccIcon from "./AccIcon.astro";
interface Props {
  id?: string; icon: string; name: string; email: string; plan: string; color: string; tint: string;
  five: number; fiveWhen: string; week: number; weekWhen: string; updated: string; winOpen?: boolean;
}
const a = Astro.props;
const glyphW = "chip-glyph chip-glyph-w";
const open = !!a.winOpen;   // the demo's starting state; data/cardState.ts takes over in the browser
const account = accounts.find((x) => x.id === a.id)!;
const full = !!fullLimit(a.id as AccountId);   // a limit is full: the plan badge turns red and Switch account shows
---
<article class="card acc" data-account={a.id}>
  <div class="acc-head">
    <AccIcon id={a.id!} src={a.icon} size={56} alt={`Dock icon of the ${a.name} profile: ${a.five}% of the 5-hour limit used`} loading="lazy" />
    <div style="display:grid;gap:2px;min-width:0">
      <div class="acc-name"><span class="dot" style={`background:${a.color}`} />Claude {a.name}</div>
      <div class="inuse"><i></i><span class="email">{a.email}</span></div>
    </div>
    <span class:list={["plan", { red: full }]}><b data-plan={a.plan}>{a.plan}</b><small>{a.updated}</small></span>
  </div>

  <div class="chips2" role="group" aria-label={`Claude window and Dock icon of ${a.name}`}>
    <div class:list={["pchip", "chip-w", { off: !open }]} data-chip-w>
      <span class={glyphW} aria-hidden="true"></span>
      <span class="pchip-text"><span class="pchip-title">Claude window</span><span class="pchip-sub" data-sub><b>{open ? "open" : "closed"}</b></span></span>
      <button type="button" class:list={["cswitch", { on: open }]} role="switch" aria-checked={open ? "true" : "false"} aria-label={`Claude window of ${a.name}`} data-win-switch={a.id}><i></i></button>
    </div>
    <!-- stopped until started (26.11.76: the Dock draws the usage, so the Dock icon app runs only once clicked) -->
    <div class="pchip chip-d off" data-chip-d>
      <span class="chip-glyph chip-glyph-d" aria-hidden="true"></span>
      <span class="pchip-text"><span class="pchip-title">Dock icon</span><span class="pchip-sub" data-sub><b>stopped</b></span></span>
      <button type="button" class="cswitch" role="switch" aria-checked="false" aria-label={`Dock icon of ${a.name}`} data-dock-switch={a.id}><i></i></button>
    </div>
  </div>

  <!-- a usage only profile (Usage in the Dock and Claude window both off): no switches, one display says so -->
  <div class="watchbar"><span class="pchip-title">Profile</span><span class="disp watch-disp"><span class="g">Usage only</span> <em>· not in the Dock · no window</em></span></div>

  <!-- the usage slot: the limits; in a state with no numbers (data/cardStates.ts) they keep their room, unseen, and the
       state's heading and sentence fill it, so the keys row stays level with every card's -->
  <div class="usage-slot">
    <Fragment set:html={cardLimitsHTML(a.id as AccountId, "segments")} />
    <div class="msgslot" data-card-msg hidden></div>
  </div>
  <!-- the keys: Show window, Terminal and ⋯; while a limit is full Terminal steps into ⋯ and Switch account (orange)
       sits at the right end, under the full display (data/cardKeys.ts draws the row, also for the demo's states) -->
  <div class="acc-actions" data-card-keys><Fragment set:html={cardKeysHTML(account, full ? fullKeys : usualKeys, open)} /></div>
</article>
