---
// What "Show window" / "Open window" opens: that profile's Claude window, covering the window's content area,
// with a short demo conversation. A neutral chat layout (not a copy of the Claude app's interface) plus a strip
// with what cl_audit set up for that profile. You can type; the reply says it's a demo.
import { accounts, chats } from "../data/demo";
---
<div class="dapps" transition:persist="dapps">
  {accounts.map((a) => {
    const c = chats[a.id].desktop;
    return (
      <section class="dapp deskwin" data-desktop={a.id} hidden aria-label={`Claude window of the ${a.name} profile (illustration)`}>
        <div class="dapp-bar">
          <span class="lights"><button type="button" class="close" data-close aria-label="Close"></button><i></i><i></i></span>
          <span class="dapp-title">Claude — {a.name}</span>
        </div>
        <div class="dapp-body">
          <aside class="dapp-side">
            <div class="dapp-acc"><span class="dot" style={`background:${a.color}`}></span>{a.name}</div>
            <div class="dapp-new">＋ New chat</div>
            <div class="dapp-recent sub">Recent</div>
            <div class="dapp-chat on">{c.title}</div>
            <i style="width:72%"></i><i style="width:86%"></i><i style="width:58%"></i><i style="width:76%"></i>
          </aside>
          <div class="dapp-main">
            <div class="dapp-strip">
              <span><span class="dot" style={`background:${a.color}`}></span><b>{a.name}</b> · <span class="email">{a.email}</span> · {a.plan}</span>
              <span class="hide-sm">Window folder <code>{a.data}</code></span>
              <span class="hide-sm">Claude Code <code>{a.dir}</code></span>
            </div>
            <div class="chat" data-chat>
              <h3 class="chat-title">{c.title}</h3>
              {c.turns.slice(0, 2).map(([who, text]) => (
                <div class:list={["msg", who]} data-step>{text}</div>
              ))}
            </div>
            <form class="composer" data-composer data-astro-reload>
              <input type="text" name="m" autocomplete="off" placeholder="Reply…" data-next={c.turns[2][1]} aria-label="Message" />
              <button type="submit" aria-label="Send">↑</button>
            </form>
            <p class="dapp-note">Illustration of the {a.name} profile's Claude window, opened by cl_audit.</p>
          </div>
        </div>
      </section>
    );
  })}
</div>

<script>
  // A small window manager for the site's desktop: Claude window and Terminal panels.
  // Opened from "Show window" / "Open window" / "Terminal", the launcher rows and the Dock; they stay open across pages.
  const w_ = window as any;
  w_.__clZ = w_.__clZ ?? 30;
  const front = (w: HTMLElement) => { w.style.zIndex = String(++w_.__clZ); };
  w_.clCloseWins = () => document.querySelectorAll<HTMLElement>(".deskwin").forEach((x) => (x.hidden = true));
  w_.clOpenWin = (w: HTMLElement | null) => {
    if (!w) return;
    document.querySelectorAll<HTMLElement>(".deskwin").forEach((x) => { if (x !== w) x.hidden = true; });
    w.hidden = false;
    front(w);
    document.dispatchEvent(new Event("cl:close-pops"));
  };
  const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The conversation plays out once: the two messages appear, then the next question is typed into the box.
  const play = (w: HTMLElement) => {
    if (w.dataset.played) return;
    w.dataset.played = "1";
    const steps = [...w.querySelectorAll<HTMLElement>("[data-step]")];
    const input = w.querySelector<HTMLInputElement>("[data-composer] input")!;
    if (reduce()) { input.value = input.dataset.next || ""; return; }
    steps.forEach((s) => (s.hidden = true));
    let i = 0;
    const next = () => {
      if (i < steps.length) { steps[i++].hidden = false; setTimeout(next, 700); return; }
      const text = input.dataset.next || "";
      let k = 0;
      const typeOne = () => { if (k <= text.length) { input.value = text.slice(0, k++); setTimeout(typeOne, 30); } };
      typeOne();
    };
    setTimeout(next, 250);
  };
  w_.clOpenDesktop = (id: string) => {
    const w = document.querySelector<HTMLElement>(`.dapp[data-desktop="${id}"]`);
    w_.clOpenWin(w);
    if (w) play(w);
  };

  // Sending a message adds it to the chat, with a reply that this is a demo. Handled before the page
  // router (capture phase on window), so the router never turns it into a page load.
  window.addEventListener("submit", (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>("[data-composer]");
    if (!form) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    const input = form.querySelector("input")!;
    const text = input.value.trim();
    if (!text) return;
    const chat = form.parentElement!.querySelector<HTMLElement>("[data-chat]")!;
    const you = document.createElement("div");
    you.className = "msg you"; you.textContent = text;
    chat.append(you);
    input.value = "";
    setTimeout(() => {
      const reply = document.createElement("div");
      reply.className = "msg claude demo";
      reply.textContent = "This is a demo window, so nothing is sent. With cl_audit installed, this profile's Claude window opens here, signed in and ready.";
      chat.append(reply);
      chat.scrollTop = chat.scrollHeight;
    }, 500);
    chat.scrollTop = chat.scrollHeight;
  }, true);

  // Navigating (the window's top bar, the menu bar) closes every panel and Dock pop-up.
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest(".switch.pages a, .menubar a, .topbar .title")) {
      w_.clCloseWins();
      document.dispatchEvent(new Event("cl:close-pops"));
    }
  }, true);
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const opener = t.closest<HTMLElement>("[data-open-desktop]");
    if (opener?.dataset.openDesktop) {
      // A Claude tile in the Dock toggles its panel: a second click closes it.
      const panel = document.querySelector<HTMLElement>(`.dapp[data-desktop="${opener.dataset.openDesktop}"]`);
      if (opener.closest(".dock") && panel && !panel.hidden) { panel.hidden = true; return; }
      w_.clOpenDesktop(opener.dataset.openDesktop);
      return;
    }
    const w = t.closest<HTMLElement>(".deskwin");
    if (w && t.closest("[data-close]")) { w.hidden = true; return; }
    if (w) front(w);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const top = [...document.querySelectorAll<HTMLElement>(".deskwin:not([hidden])")].sort((a, b) => +b.style.zIndex - +a.style.zIndex)[0];
    if (top) top.hidden = true;
  });
</script>
