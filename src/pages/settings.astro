          n = Math.min(26, n + 2);
          root.querySelectorAll<HTMLElement>("[data-rs-count]").forEach((e) => (e.textContent = String(n)));
          if (n < 26) rsTimer = window.setTimeout(tick, 250); else { rs = "done"; show(); }
        };
        rsTimer = window.setTimeout(tick, 400);
        return;
      }
      if (pick("[data-rs-stop]")) {
        clearTimeout(rsTimer); openPage("");
        showWhatNow("Restore stopped", "", "What's already back stays; the rest is still in the backup. This is a demo, so nothing changed.");
        return;
      }
      if (pick("[data-rs-undo]")) {
        openPage("");
        showWhatNow("Undo this restore", "", "It is meant to take back what the restore put back, though it may not bring everything back. This is a demo, so nothing changed.");
        return;
      }
      if ((b = pick("[data-sess-demo]"))) {
        const what = b.dataset.sessDemo!;
        openPage("");
        showWhatNow(what, "", what === "Export" ? "Experimental: export can lose data. cl_audit writes one file of this profile's sessions. This is a demo, so nothing is written."
          : what === "Move" ? "Experimental: Move to another Mac can lose data. cl_audit writes one encrypted disk image with every profile, its setup, the window's MCP settings and scheduled tasks, and cl_audit's own profiles and settings. Project folders don't travel; the Code row lists each project to clone on the new Mac. Rewind's copies of edited files come only if you include them. This is a demo, so nothing is written."
          : what === "Import a move" ? "Experimental: import can lose data. home's sessions go in, each Code-tab entry and task under its own account. Then import work's and side's parts from their own Sessions. This is a demo, so nothing changed."
          : "Experimental: import can lose data. cl_audit unpacks the file as a backup of this profile, then restores from it. This is a demo, so nothing changed.");
        return;
      }
      // Sign in with another account…: Claude Code's own sign-in on the profile's folder, no address filled in
      if (pick("[data-sign-other]")) {
        const own = accounts.find((x) => x.id === acc)!;
        showWhatNow("Sign in with another account…", "", `Claude Code's own sign-in opens in Terminal for ${own.dir}, with no address filled in. The account that signs in becomes the one ${who()} works on; the one before goes on standby. This is a demo, so nothing opens.`);
        return;
      }
      // a standby account's address is a pop-up: Switch to it… (the Switch page with it picked) and Forget…
      if ((b = pick("[data-sb-btn]"))) {
        const email = b.dataset.sbBtn!;
        menuToggle(`[data-sb-btn="${email}"]`, `[data-sb-menu="${email}"]`, () =>
          `<button type="button" class="lm-row act" data-sb-switch="${email}">Switch to it…</button><hr><button type="button" class="lm-row act" data-sb-forget="${email}">Forget…</button>`);
        return;
      }
      if ((b = pick("[data-sb-switch]"))) { closeMenus(); (window as any).clOpenSwitch?.(acc, b.dataset.sbSwitch); return; }
      if ((b = pick("[data-sb-forget]"))) {
        // asks first; nothing on the Mac changes, and signing in to it in this profile's folder brings it back
        const email = b.dataset.sbForget!;
        closeMenus();
        ask(`Forget ${email}?`, `${who()} stops listing it. Nothing on this Mac changes; signing in to it in this profile's folder brings it back.`, "Forget", `[data-sb-btn="${email}"]`, () => { removedSb.add(`${acc}:${email}`); show(); });
        return;
      }
      // Folders from before: Keep it, Show in Finder, and Move to Trash… (asks first, says what is in it and names the Keychain item)
      if ((b = pick("[data-left-keep]"))) { gone.add(`${acc}:${b.dataset.leftKeep}`); showLeftovers(); return; }
      if ((b = pick("[data-left-finder]"))) { showWhatNow("Show in Finder", "", `${b.dataset.leftFinder} opens in Finder, so you can look at what is in it. This is a demo, so nothing opens.`); return; }
      if ((b = pick("[data-left-trash]"))) {
        const f = LEFT[acc].find((x) => x.path === b!.dataset.leftTrash)!;
        ask(`Move ${f.path} to the Trash?`, `In it: ${f.inside}. Everything in it goes with it; you can put it back from the Trash. The sign-in itself isn't in the folder: Claude Code keeps it in your Keychain as “${f.keychain}”. Delete that in Keychain Access if you no longer need it; cl_audit doesn't touch it.`, "Move to Trash", `[data-left-trash="${f.path}"]`, () => { gone.add(`${acc}:${f.path}`); showLeftovers(); });
        return;
      }
      if (pick("[data-ask-yes]")) { $("[data-ask]")!.hidden = true; const done = askDone; askDone = null; done?.(); return; }
      if (pick("[data-ask-no]") || t.matches("[data-ask]")) { askCancel(); return; }
      if (!pick(".login-menu") && $$(".login-menu").some((m) => !m.hidden)) closeMenus();
      if (pick("[data-udialog-close]") || t.matches("[data-udialog]")) { $("[data-udialog]")!.hidden = true; return; }
      if (pick("[data-dialog-close]") || t.matches("[data-dialog]")) { $("[data-dialog]")!.hidden = true; return; }
    });
    root.addEventListener("change", (e) => {
      const t = e.target as HTMLSelectElement | HTMLInputElement;
      // Import's File: an ordinary export, or a move from another Mac (its own page, profiles first)
      if (t.matches("[data-sess-file]")) { mv = "plan"; openPage(t.value); return; }
      const f = t.dataset.field as keyof Prefs | undefined;
      // Dock icon ▸ Click: with the usage-only choices, Usage panel brings back "Usage, then Claude" (shown as the
      // usage panel until a Claude window may open again), unless a Claude choice is stored that already shows it
      if (t.matches("[data-click]")) {
        const pr = p();
        if (opens(pr)) pr.click = t.value;
        else if (t.value === "Details panel") pr.click = "Details panel";
        else if (pr.click === "Details panel" || !pr.win) pr.click = "Usage, then Claude";
        commit(); show(); say("click"); return;
      }
      if (f === "opensFromDock") { p().opensFromDock = t.value === "1"; commit(); show(); say("opensFromDock"); return; }
      if (f && t.tagName === "SELECT") {
        (p() as any)[f] = t.value; commit(); show();
        if (f === "refresh") say(f);
      }
    });
    // a name or label edit: saved on Return or leaving the field, Esc puts it back (the field keeps the focus)
    const isEF = (t: EventTarget | null): t is HTMLInputElement => t instanceof HTMLInputElement && (t.dataset.field === "name" || t.dataset.field === "label");
    root.addEventListener("input", (e) => {
      const t = e.target; if (!isEF(t)) return;
      const f = t.dataset.field as EF, v = tidy(f, t.value);
      if (v !== t.value) t.value = v;
      drafts[f] = { owner: acc, value: v, problem: "" };
      paintField(f); statusIdle();
    });
    root.addEventListener("keydown", (e) => {
      // Esc answers Cancel to Forget… / Move to Trash…, else closes an Accounts pop-up
      if (e.key === "Escape" && !$("[data-ask]")!.hidden) { askCancel(); return; }
      if (e.key === "Escape" && $$(".c-c .login-menu").some((m) => !m.hidden)) { closeMenus(); return; }
      const t = e.target; if (!isEF(t)) return;
      if (e.key === "Enter") { e.preventDefault(); saveEdit(t.dataset.field as EF); }
      if (e.key === "Escape") { e.preventDefault(); revertEdit(t.dataset.field as EF); }
    });
    root.addEventListener("focusout", (e) => {
      const t = e.target; if (isEF(t)) saveEdit(t.dataset.field as EF);
    });
    // Profile order (26.11.0): drag a profile's tile left or right along the strip (General stays first, ＋ last);
    // saved on drop. The dashboard, launcher, menu bar icons, widget and history follow it; the Dock doesn't.
    let dragged: HTMLElement | null = null;
    const profTile = (t: EventTarget | null) => (t as HTMLElement | null)?.closest?.<HTMLElement>("[data-select-acc]:not([data-select-acc='general'])") ?? null;
    root.addEventListener("dragstart", (e) => {
      dragged = profTile(e.target); if (!dragged) return;
      dragged.classList.add("dragging");
      e.dataTransfer?.setData("text/plain", dragged.dataset.selectAcc!);
      if (e.dataTransfer) e.dataTransfer.effectAllowed = "move";
    });
    root.addEventListener("dragover", (e) => {
      const over = profTile(e.target); if (!dragged || !over) return;
      e.preventDefault();
      if (over === dragged) return;
      const r = over.getBoundingClientRect();
      over.parentElement!.insertBefore(dragged, e.clientX < r.left + r.width / 2 ? over : over.nextSibling);
    });
    root.addEventListener("drop", (e) => { if (dragged) e.preventDefault(); });
    root.addEventListener("dragend", () => {
      if (!dragged) return;
      dragged.classList.remove("dragging"); dragged = null;
      const order = $$<HTMLElement>(".strip [data-select-acc]").map((t) => t.dataset.selectAcc!).filter((x) => x !== "general") as AccountId[];
      if (order.join() === loadOrder().join()) return;
      saveOrder(order); applyPrefs(prefs); if (general) showWidget();
      status('<span class="g">Saved</span> <em>· order</em>', 2500);
    });
    // the key caps under a field don't take the focus from it (a click on them isn't "clicking elsewhere")
    root.addEventListener("mousedown", (e) => { if ((e.target as HTMLElement).closest("[data-cap]")) e.preventDefault(); });

    // Show emails (General), shared with the rest of the site
    const sws = $$("[data-toggle-emails]");
    const syncEmails = () => {
      const on = !document.documentElement.classList.contains("hide-emails");
      sws.forEach((s) => setSwitch(s, on)); $("[data-emails-t]")!.textContent = on ? "shown" : "hidden";
    };
    syncEmails();
    sws.forEach((sw) => sw.addEventListener("click", () => {
      if (sw.matches(".pulse-on, .pulse-off")) return;
      const on = document.documentElement.classList.contains("hide-emails");   // it was off, so it turns on
      pulse(sw, $("[data-emails-t]"), on, 600, () => {
        document.documentElement.classList.toggle("hide-emails", !on);
        try { localStorage.setItem("cl_audit.showEmails", on ? "1" : "0"); } catch {}
        syncEmails();
        showWhatNow("Show emails", on ? "on" : "off", on
          ? "Email addresses show everywhere in cl_audit."
          : "Email addresses are left out of the launcher, dashboard, panels and Dock menus, and blurred in Settings — for screen sharing.");
      });
    }));
    // Privacy ▸ Usage history (26.11.0), shared with the dashboard: off, its history (charts, totals, CSV) is hidden
    const hsw = $("[data-toggle-history]")!;
    const syncHistory = () => {
      const on = !document.documentElement.classList.contains("no-history");
      setSwitch(hsw, on); $("[data-history-t]")!.textContent = on ? "tokens, cost, CSV" : "limits only";
    };
    syncHistory();
    hsw.addEventListener("click", () => {
      if (hsw.matches(".pulse-on, .pulse-off")) return;
      const on = document.documentElement.classList.contains("no-history");   // it was off, so it turns on
      pulse(hsw, $("[data-history-t]"), on, 600, () => {
      try { localStorage.setItem("cl_audit.usageHistory", on ? "1" : "0"); } catch {}
      applyPrefs(prefs); syncHistory();
      showWhatNow("Usage history", on ? "on" : "off", on
        ? "The dashboard's history, cost estimate and CSV are read from Claude Code's session files on this Mac again."
        : "cl_audit reads none of Claude Code's session files, so the dashboard's history, cost estimate and CSV are hidden. The limits still come from Anthropic.");
      });
    });
    show();
    // from the dashboard card's or a menu's "Switch account": /settings/?switch=work&to=<address>
    const qs = new URLSearchParams(location.search);
    if (qs.get("switch")) {
      (window as any).clOpenSwitch(qs.get("switch"), qs.get("to") ?? undefined);
      history.replaceState(history.state, "", location.pathname);   // a reload shows the settings again
    }
  }
  document.addEventListener("astro:page-load", setup);
</script>
