---
import { render } from "astro:content";
import Reader from "../../layouts/Reader.astro";
import { getUseCases } from "../../data/content";

export async function getStaticPaths() {
  return (await getUseCases()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Reader entry={entry} section="usecases" headings={headings}><Content /></Reader>
