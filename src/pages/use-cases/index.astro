---
import Desktop from "../../layouts/Desktop.astro";
import "../../styles/reader.css";
import { getUseCases, pathOf, dateText } from "../../data/content";
import { orgNode, webPage, breadcrumbs } from "../../data/schema";

const items = await getUseCases();
const title = "Claude use cases: accounts, alerts, usage history";
const description = "What you can do with cl_audit on a Mac: run several Claude accounts side by side, get usage limit alerts, and read your Claude Code usage history.";
const jsonLd = [
  webPage({ path: "/use-cases/", name: title, description, type: "CollectionPage" }),
  breadcrumbs([{ name: "Home", path: "/" }, { name: "Use cases", path: "/use-cases/" }]),
  orgNode,
];
---
<Desktop title={title} description={description} page="usecases" headline="What you can do with it" jsonLd={jsonLd}>
  <div class="content-inner reader">
    <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Use cases</li></ol></nav>
    <p class="ix-lede">cl_audit is a free Mac app that shows each Claude profile's usage limits in the Dock. These pages show what that is good for, one job at a time.</p>
    <div class="ix-list">
      {items.map((e) => (
        <div class="card">
          <h4>Use case</h4>
          <h2><a href={pathOf("usecases", e.id)}>{e.data.h1}</a></h2>
          <p>{e.data.description}</p>
          <span class="when">Updated {dateText(e.data.updated)}</span>
        </div>
      ))}
    </div>
  </div>
</Desktop>
