---
import Desktop from "../layouts/Desktop.astro";
import AccountCard from "../components/AccountCard.astro";
import History from "../components/History.astro";
import Experimental from "../components/Experimental.astro";
import { accounts } from "../data/demo";
import { orgNode, webPage, breadcrumbs } from "../data/schema";

// main keyword: "Claude usage dashboard"
const title = "Claude usage dashboard: limits and Claude Code history";
const description =
  "A demo of cl_audit's Claude usage dashboard: each profile's 5-hour and weekly limits, plus Claude Code usage history by day, project and model.";
const jsonLd = [
  webPage({ path: "/dashboard/", name: title, description }),
  breadcrumbs([{ name: "Home", path: "/" }, { name: "Demo dashboard", path: "/dashboard/" }]),
  orgNode,
];
---
<Desktop title={title} description={description} page="dashboard" headline="Claude usage dashboard · sample data, 3 profiles" jsonLd={jsonLd}>
  <div class="content-inner dash" id="dash" data-range="7d">
    <!-- the app's own header row, as in cl_audit: which profiles are shown, and when it last updated -->
    <!-- as the app's top strip: a key per profile (latched while shown, its strip in the profile's colour), then
         the last update in a fixed-width display with a refresh key; every control 26 px on one centre line -->
    <div class="dash-bar">
      <span class="strip26" role="group" aria-label="Profiles shown">
        {accounts.map((a) => (
          <button type="button" class="key k lt" data-chip={a.id} style={`--lamp:${a.color}`} aria-pressed="true" title={`Hide ${a.name} from the dashboard`}>{a.name}</button>
        ))}
        <span class="vdiv" aria-hidden="true"></span>
        <span class="disp fixed" data-updated>Updated <em>· just now</em></span>
        <button type="button" class="key k sq" data-refresh-all title="Refresh now" aria-label="Refresh now">↻</button>
      </span>
    </div>
    <div class="dash-cards">{accounts.map((a) => <AccountCard {...a} />)}</div>
    <Experimental flows={["switch"]} />
    <History />
    <!-- 26.10.5: until the first scan of the session files is done, the history says it's reading them (once per
         visit; set before the first paint so the numbers don't flash) -->
    <script is:inline>
      (function () {
        try { if (sessionStorage.getItem("cl_audit.scanned")) return; } catch (e) { return; }
        var d = document.getElementById("dash");
        if (!d) return;
        d.classList.add("reading");
        d.querySelectorAll(".hist-total").forEach(function (el) { el.innerHTML = "Reading… <em>· session files</em>"; });
      })();
    </script>
  </div>
</Desktop>

<style>
  .dash-bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .no-charts { margin: 0; padding: 18px; text-align: center; border-radius: 6px; background: var(--win-bg); box-shadow: var(--win-shadow); }
</style>

<script>
  import { rangeHTML, sharesHTML, totalsHTML, csvFor } from "../data/historyView";
  import { loadPrefs, loadOrder, saveOrder, applyPrefs } from "../data/prefs";
  import { allIds, type AccountId, type Range } from "../data/demo";

  const KEY = "cl_audit.dashboardHidden";
  const CHARTS = "cl_audit.dashboardCharts";   // charts switched off with their keys
  const loadCharts = (): string[] => { try { return JSON.parse(localStorage.getItem(CHARTS) || "[]"); } catch { return []; } };

  /** Shows the charts whose keys are latched; the tokens key names the period's chart (per hour for 24 h). */
  function applyCharts(dash: HTMLElement) {
    const off = loadCharts();
    dash.querySelectorAll<HTMLButtonElement>("[data-chart-key]").forEach((b) => {
      const on = !off.includes(b.dataset.chartKey!);
      b.classList.toggle("lt", on); b.setAttribute("aria-pressed", String(on));
    });
    dash.querySelectorAll<HTMLElement>("[data-chart]").forEach((c) => (c.hidden = off.includes(c.dataset.chart!)));
    const none = dash.querySelector<HTMLElement>(".no-charts");
    if (none) none.hidden = off.length < 3;
    const t = dash.querySelector<HTMLElement>("[data-tokens-title]");
    if (t) t.textContent = dash.dataset.range === "24h" ? "Tokens per hour" : "Tokens per day";
    fitTotals(dash);
  }
  /** The totals display on one line: the first wording that fits (with the cost at list prices, the cost alone, none). */
  function fitTotals(dash: HTMLElement) {
    const ids = allIds.filter((id) => !load().includes(id)) as AccountId[];
    dash.querySelectorAll<HTMLElement>(".hist-total").forEach((el) => {
      if (!el.offsetParent) return;
      for (const level of [0, 1, 2]) {
        el.innerHTML = totalsHTML(el.dataset.range as Range, ids, level);
        if (el.scrollWidth <= el.clientWidth + 1) break;
      }
    });
  }
  const load = (): string[] => { try { return JSON.parse(localStorage.getItem(KEY) || "[]"); } catch { return []; } };
  const save = (v: string[]) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} };

  function render(dash: HTMLElement, hidden: string[]) {
    const ids = allIds.filter((id) => !hidden.includes(id)) as AccountId[];
    document.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((b) => {
      const on = !hidden.includes(b.dataset.chip!);
      b.classList.toggle("lt", on); b.setAttribute("aria-pressed", String(on));
    });
    dash.querySelectorAll<HTMLElement>(".dash-cards [data-account]").forEach((c) => (c.hidden = hidden.includes(c.dataset.account!)));
    dash.querySelectorAll<HTMLElement>(".legend-item").forEach((l) => (l.hidden = hidden.includes(l.dataset.account!)));
    dash.querySelectorAll<HTMLElement>(".range-block").forEach((el) => (el.innerHTML = rangeHTML(el.dataset.range as Range, ids)));
    dash.querySelectorAll<HTMLElement>(".range-shares").forEach((el) => (el.innerHTML = sharesHTML(el.dataset.range as Range, ids)));
    dash.querySelectorAll<HTMLElement>(".hist-total").forEach((el) => (el.innerHTML = totalsHTML(el.dataset.range as Range, ids)));
    fitTotals(dash);
    applyCharts(dash);
  }

  function setup() {
    // the strip's one display: "Updated · just now"; hovering it says what cl_audit's background agent reads (26.10.11)
    const upd = document.querySelector<HTMLElement>("[data-updated]");
    if (upd) {
      const mins = Object.values(loadPrefs()).map((p) => parseInt(p.refresh));
      const lo = Math.min(...mins), hi = Math.max(...mins), n = mins.length;
      upd.title = `Reading usage for ${n} profile${n === 1 ? "" : "s"}, every ${lo === hi ? lo : `${lo}–${hi}`} min, in the background`;
    }
    const dash = document.getElementById("dash");
    if (!dash || dash.dataset.ready) return;
    dash.dataset.ready = "1";
    let hidden = load();
    if (hidden.length || dash.classList.contains("reading")) render(dash, hidden);
    applyCharts(dash);
    // the first scan "finishes": the totals and charts come in
    if (dash.classList.contains("reading")) {
      dash.querySelectorAll<HTMLElement>(".hist-total").forEach((el) => (el.innerHTML = "Reading… <em>· session files</em>"));
      setTimeout(() => {
        dash.classList.remove("reading");
        try { sessionStorage.setItem("cl_audit.scanned", "1"); } catch {}
        render(dash, load());
      }, 1600);
    }
    dash.querySelectorAll<HTMLButtonElement>("[data-chart-key]").forEach((b) =>
      b.addEventListener("click", () => {
        const id = b.dataset.chartKey!, off = loadCharts();
        const next = off.includes(id) ? off.filter((x) => x !== id) : [...off, id];
        try { localStorage.setItem(CHARTS, JSON.stringify(next)); } catch {}
        applyCharts(dash);
      }),
    );
    // Refresh: the display says Updating… for a moment, as the app's does
    dash.querySelector("[data-refresh-all]")?.addEventListener("click", () => {
      const d = dash.querySelector<HTMLElement>("[data-updated]");
      const k = dash.querySelector<HTMLElement>("[data-refresh-all]")!;
      if (!d || k.classList.contains("busy")) return;
      // while updating, the key's arrow itself lights up green and pulses like an LED; it takes no clicks (26.10.6)
      d.innerHTML = "Updating…";
      k.classList.add("busy"); k.innerHTML = '<span class="rlit" aria-hidden="true">↻</span>';
      setTimeout(() => { d.innerHTML = "Updated <em>· just now</em>"; k.classList.remove("busy"); k.textContent = "↻"; }, 1400);
    });
    // CSV (26.11.0): saves the period and the shown profiles as CSV, as the app's key does; the rows are the demo's
    dash.querySelector<HTMLButtonElement>("[data-csv]")?.addEventListener("click", () => {
      const ids = allIds.filter((id) => !load().includes(id)) as AccountId[];
      const blob = new Blob([csvFor((dash.dataset.range || "7d") as Range, ids)], { type: "text/csv" });
      const url = URL.createObjectURL(blob), a = document.createElement("a");
      a.href = url; a.download = `cl_audit-usage-${dash.dataset.range || "7d"}-sample.csv`;
      document.body.append(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
    dash.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) =>
      b.addEventListener("click", () => {
        dash.dataset.range = b.dataset.pick!;
        dash.querySelectorAll("[data-pick]").forEach((x) => x.classList.toggle("lt", x === b));
        applyCharts(dash);
      }),
    );
    document.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((b) =>
      b.addEventListener("click", () => {
        const id = b.dataset.chip!;
        hidden = hidden.includes(id) ? hidden.filter((x) => x !== id) : [...hidden, id];
        save(hidden);
        render(dash, hidden);
      }),
    );
    // Drag a card to change the profiles' order (26.11.0), the same order and save as Settings' tile bar. A card is
    // picked up by its body or header: its keys and switches keep their clicks, a drag never starts from one.
    const grid = dash.querySelector<HTMLElement>(".dash-cards")!;
    let fromKey = false, dragged: HTMLElement | null = null;
    grid.querySelectorAll<HTMLElement>(":scope > [data-account]").forEach((c) => (c.draggable = true));
    grid.addEventListener("pointerdown", (e) => { fromKey = !!(e.target as HTMLElement).closest("button, a, input, select, [role=switch]"); });
    grid.addEventListener("dragstart", (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>(".dash-cards > [data-account]");
      if (!card || fromKey) { e.preventDefault(); return; }
      dragged = card; card.classList.add("dragging");
      e.dataTransfer?.setData("text/plain", card.dataset.account!);
      if (e.dataTransfer) e.dataTransfer.effectAllowed = "move";
    });
    grid.addEventListener("dragover", (e) => {
      const over = (e.target as HTMLElement).closest<HTMLElement>(".dash-cards > [data-account]");
      if (!dragged || !over) return;
      e.preventDefault();
      if (over === dragged) return;
      const r = over.getBoundingClientRect();
      grid.insertBefore(dragged, e.clientX < r.left + r.width / 2 ? over : over.nextSibling);
    });
    grid.addEventListener("drop", (e) => { if (dragged) e.preventDefault(); });
    grid.addEventListener("dragend", () => {
      if (!dragged) return;
      dragged.classList.remove("dragging"); dragged = null;
      const order = [...grid.querySelectorAll<HTMLElement>(":scope > [data-account]")].map((c) => c.dataset.account!) as AccountId[];
      if (order.join() === loadOrder().join()) return;
      saveOrder(order); applyPrefs(loadPrefs()); render(dash, hidden);
      const d = dash.querySelector<HTMLElement>("[data-updated]");
      if (d) { d.innerHTML = '<span class="g">Saved</span> <em>· order</em>'; setTimeout(() => (d.innerHTML = "Updated <em>· just now</em>"), 2500); }
    });
  }
  document.addEventListener("astro:page-load", setup);
</script>
