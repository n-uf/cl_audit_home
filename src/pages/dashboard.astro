---
import Desktop from "../layouts/Desktop.astro";
import AccountCard from "../components/AccountCard.astro";
import History from "../components/History.astro";
import { accounts } from "../data/demo";

const title = "Dashboard — cl_audit: Claude usage limits and history for every account";
const description =
  "The cl_audit dashboard: each Claude account's 5-hour session limit and weekly limit, read directly from Anthropic, plus usage history: when you use Claude, tokens per day, and which projects, models and apps they went to.";
---
<Desktop title={title} description={description} page="dashboard">
  <Fragment slot="top">
    <span class="chips" role="group" aria-label="Accounts shown"><span class="lbl">Show</span>
      {accounts.map((a) => (
        <button type="button" class="chip on" data-chip={a.id}><span class="chip-ck" style={`background:${a.color}`}>✓</span>{a.name}</button>
      ))}
    </span>
    <span class="updated hide-sm">Updated just now</span>
  </Fragment>

  <div class="content-inner dash" id="dash" data-range="7d">
    <h1 class="sr-only">cl_audit dashboard (demo accounts)</h1>
    <div class="dash-cards">{accounts.map((a) => <AccountCard {...a} />)}</div>
    <History />
  </div>
</Desktop>

<script>
  function setup() {
    const dash = document.getElementById("dash");
    if (!dash || dash.dataset.ready) return;
    dash.dataset.ready = "1";
    dash.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) =>
      b.addEventListener("click", () => {
        dash.dataset.range = b.dataset.pick!;
        dash.querySelectorAll("[data-pick]").forEach((x) => x.classList.toggle("on", x === b));
      }),
    );
    document.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((b) =>
      b.addEventListener("click", () => {
        const on = b.classList.toggle("on");
        dash.querySelectorAll<HTMLElement>(`.dash-cards [data-account="${b.dataset.chip}"]`).forEach((c) => (c.hidden = !on));
      }),
    );
  }
  document.addEventListener("astro:page-load", setup);
</script>
