---
import Base from "../layouts/Base.astro";
import AccountCard from "../components/AccountCard.astro";
import Row from "../components/Row.astro";

const repo = "https://github.com/n-uf/cl_audit";
const title = "cl_audit — run several Claude accounts on macOS, with usage limits in the Dock";
const description =
  "cl_audit runs a separate Claude desktop app for each of your Claude accounts on macOS, shows each account's usage limits live in the Dock, and keeps a usage dashboard with figures read directly from Anthropic. Free and source-available.";

const accounts = [
  { id: "home", icon: "/img/dock-home.png", name: "home", email: "you@example.com", plan: "Max", color: "var(--orange)", tint: "t-orange", five: 34, fiveWhen: "resets in 3 h 12 min", week: 12, weekWhen: "resets in 6 days", updated: "just now" },
  { id: "work", icon: "/img/dock-work.png", name: "work", email: "you@work.example", plan: "Team", color: "var(--blue)", tint: "t-blue", five: 78, fiveWhen: "resets in 41 min", week: 61, weekWhen: "resets in 3 days", updated: "1 min ago" },
  { id: "side", icon: "/img/dock-side.png", name: "side", email: "side@example.com", plan: "Pro", color: "var(--teal)", tint: "t-teal", five: 12, fiveWhen: "resets in 4 h 40 min", week: 40, weekWhen: "resets in 5 days", updated: "2 min ago" },
];

// 7 days of tokens per account, for the launcher's dashboard card (millions)
const week = [[6, 2], [11, 4], [9, 5], [8, 3], [14, 6], [12, 5], [3, 1]];
const top = Math.max(...week.map(([a, b]) => a + b));

const anchors = [
  { href: "#accounts", n: "1", title: "Several Claude accounts, side by side",
    text: "A separate Claude desktop app for each account, each with its own sign-in and its own Claude Code configuration." },
  { href: "#dock", n: "2", title: "Usage limits, right in the Dock",
    text: "One live icon per account with the 5-hour session limit and the weekly limit, updated every few minutes." },
  { href: "#dashboard", n: "3", title: "A usage dashboard you can rely on",
    text: "Limits read directly from Anthropic, the same figures Claude shows in Settings ▸ Usage, plus your usage history." },
];

const styles = [
  ["bars", "Two numbers"], ["rings", "Rings"], ["number", "Big number"], ["twinRings", "Twin rings"],
  ["segmented", "Segmented"], ["pace", "Pace bars"], ["statusTile", "Status tile"], ["gauge", "Gauge"],
  ["worst", "Worst of two"], ["statusBar", "Status + week bar"], ["thinBars", "Number + bars"],
  ["batteries", "Batteries"], ["gaugeBar", "Gauge + week bar"],
];
const lane = ["plenty left", "", "half used", "", "at the limit"];
const panels = [["glow", "Glow"], ["segments", "Segments"], ["rings", "Rings"], ["numbers", "Numbers"], ["pace", "Pace"]];

const faq = [
  ["Can I run several Claude desktop apps at the same time?",
   "Yes. cl_audit starts a separate instance of the Claude desktop app for each account, each with its own app data folder, so each keeps its own sign-in. The Code tab and the Claude Code CLI use that account's own configuration directory (CLAUDE_CONFIG_DIR)."],
  ["Where do the usage figures come from?",
   "The 5-hour session limit and the weekly limit are read directly from Anthropic for each account, using that account's Claude Code sign-in: the same figures Claude shows in Settings ▸ Usage, with their reset times. The usage history on the dashboard comes from the Claude Code session logs on your Mac."],
  ["Is cl_audit made by Anthropic?",
   "No. cl_audit is an independent, source-available tool from n-uf. It is not affiliated with, endorsed by or sponsored by Anthropic. Claude is a trademark of Anthropic."],
  ["Does it send my data anywhere?",
   "Only to Anthropic, to read each account's usage. There is no cl_audit server, no analytics and no account to create. Sign-ins are read read-only from the macOS Keychain with Apple's security tool, the same way Claude Code reads them, and are never written to disk or logged."],
  ["Which plans does it support?",
   "Claude plans with usage limits, such as Pro, Max and Team, signed in to Claude Code. Accounts that use an API key are billed per token instead and have no usage limits to show."],
  ["What does it need?",
   "A Mac with Apple silicon and macOS 13 or later, the Xcode Command Line Tools to build it, and Claude Code signed in for each account. The Claude desktop app is needed only for the side-by-side desktop apps."],
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "cl_audit",
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS 13 or later",
    url: "https://cl-audit.n-uf.com/",
    downloadUrl: repo,
    image: "https://cl-audit.n-uf.com/img/app-icon.png",
    featureList: anchors.map((a) => a.title),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    author: { "@type": "Organization", name: "n-uf", url: "https://n-uf.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <header class="bar">
    <div class="wrap">
      <a class="brand" href="/" aria-label="cl_audit home"><img src="/img/app-icon.png" alt="" width="26" height="26" />cl_audit</a>
      <span class="spacer"></span>
      <nav class="switch hide-sm" aria-label="Sections">
        <a href="#accounts">Accounts</a>
        <a href="#dock">Dock</a>
        <a href="#dashboard">Dashboard</a>
        <a href="#install">Install</a>
      </nav>
      <a class="pill small" href={repo}>GitHub</a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <div class="hero wrap">
      <div class="grid2">
        <div>
          <p class="eyebrow">For Claude Pro, Max and Team · macOS</p>
          <h1>Every Claude account, side by side on your Mac.</h1>
          <p class="lead">
            cl_audit runs a separate Claude desktop app for each of your accounts, shows each account's usage
            limits live in the Dock, and keeps a usage dashboard with figures read directly from Anthropic.
          </p>
          <div class="ctas">
            <a class="pill tint t-orange" href="#install">Install</a>
            <a class="pill" href={repo}>View source on GitHub</a>
          </div>
          <p class="note">Free · source-available · runs entirely on your Mac</p>
        </div>

        <div class="palette" aria-label="The cl_audit launcher">
          <div class="search">⌕ <span>Open Claude for…</span><span class="kbd">⌘1–3</span></div>
          {accounts.map((a, i) => <Row icon={a.icon} name={a.name} color={a.color} five={a.five} week={a.week} key={`⌘${i + 1}`} sel={i === 0} open={i < 2} />)}
          <div class="dash-card">
            <div class="spark" aria-hidden="true">
              {week.map(([a, b]) => (
                <span><i style={`height:${(a / top) * 26}px;background:var(--orange)`} /><i style={`height:${(b / top) * 26}px;background:var(--blue)`} /></span>
              ))}
            </div>
            <div style="flex:1;min-width:0">
              <div style="font-weight:600;font-size:14px">Dashboard</div>
              <div class="sub" style="font-size:12px">3,182 replies · 89.4M tokens · last 7 days</div>
            </div>
            <span class="kbd">⌘D</span><span class="sub">›</span>
          </div>
          <div class="foot"><span>click or ↩ desktop app · ⌘↩ Terminal</span><span>⚙︎</span></div>
        </div>
      </div>

      <nav class="anchors" aria-label="What cl_audit does">
        {anchors.map((a) => (
          <a class="card anchor" href={a.href}>
            <span class="num">{a.n}</span>
            <b>{a.title}</b>
            <span class="sub">{a.text}</span>
          </a>
        ))}
      </nav>
    </div>

    <!-- 1 · Several accounts -->
    <section id="accounts">
      <div class="wrap">
        <p class="eyebrow">1 · Several Claude accounts</p>
        <h2>Run your personal, work and side-project accounts at the same time</h2>
        <p class="lead">
          The Claude desktop app signs in to one account at a time. cl_audit starts a separate instance of the
          Claude desktop app for each account, each with its own app data folder, so every account stays signed
          in, next to the others. The Code tab and the Claude Code CLI use that account's own configuration
          directory, with its own sign-in, settings and history.
        </p>
        <div class="grid2" style="align-items:start;margin-top:28px">
          <div class="card">
            <h4>Open the right account</h4>
            <div class="list">
              <div><b>Click the cl_audit icon</b><span>The launcher lists every account with both limits. Click one, or press ⌘1–9, to bring up its Claude desktop app.</span></div>
              <div><b>⌘↩ for Claude Code</b><span>Opens Terminal with Claude Code already set to that account.</span></div>
              <div><b>Shared where you want it</b><span>Your CLAUDE.md, agents, skills and commands can be linked from your main account, while sign-ins and usage stay separate.</span></div>
            </div>
          </div>
          <div class="card">
            <h4>Add an account</h4>
            <div class="list">
              <div><b>✓ Create the folders and links</b><span>A Claude Code configuration directory and a desktop app data folder for the account.</span></div>
              <div><b>✓ Sign in to Claude Code</b><span>Opens Terminal for the sign-in. The step turns green once the account is signed in, and warns if another account already uses the same sign-in.</span></div>
              <div><b>○ Open the Claude desktop app</b><span>Its own instance with its own sign-in. Optional if you only use Claude Code in the terminal.</span></div>
              <div><b>○ Add the Dock icon</b><span>Finish adds the account and installs its icon.</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · Dock -->
    <section id="dock">
      <div class="wrap">
        <p class="eyebrow">2 · Usage limits in the Dock</p>
        <h2>Every account's limits, one glance away</h2>
        <p class="lead">
          Each account gets its own Dock icon showing how much of its 5-hour session limit and its weekly limit
          is used. Click it to see the figures for a moment while that account's Claude desktop app opens;
          double-click it for the full panel. A notification warns you before an account reaches its limit.
        </p>
        <div class="dock-wrap">
          <div class="dock" aria-label="cl_audit icons in the macOS Dock">
            <img src="/img/app-icon.png" alt="The cl_audit app icon" width="64" height="64" />
            <span class="sep"></span>
            {accounts.map((a) => <img src={a.icon} alt={`${a.name} account: ${a.five}% of the 5-hour session limit and ${a.week}% of the weekly limit used`} width="64" height="64" />)}
          </div>
        </div>

        <h3 class="sub-h">Thirteen icon styles</h3>
        <p class="sub" style="max-width:62ch">Pick a style, an account colour and an optional frame for each account. Status styles turn green, amber and red as a limit fills up.</p>
        <div class="styles">
          {styles.map(([k, n]) => (
            <figure class="style"><img src={`/img/style-${k}.png`} alt={`${n} icon style`} width="72" height="72" loading="lazy" /><figcaption>{n}</figcaption></figure>
          ))}
        </div>
        <div class="card lane">
          <h4>Preview · as the limit fills up</h4>
          <div class="lane-bar"><i style="background:var(--green)"></i><i style="background:var(--green)"></i><i style="background:var(--amber)"></i><i style="background:var(--red)"></i><i style="background:var(--red)"></i></div>
          <div class="lane-icons">
            {lane.map((t, i) => (
              <figure><img src={`/img/lane-${i}.png`} alt={`Two numbers style at level ${i + 1} of 5`} width="56" height="56" loading="lazy" /><figcaption>{t}</figcaption></figure>
            ))}
          </div>
        </div>

        <h3 class="sub-h">Five panel designs</h3>
        <p class="sub" style="max-width:62ch">Both limits with their reset times, the plan, and buttons to open Claude or the dashboard.</p>
        <div class="panels">
          {panels.map(([k, n]) => (
            <figure><img src={`/img/panel-${k}.png`} alt={`${n} panel design showing the 5-hour session limit and the weekly limit`} width="800" height="540" loading="lazy" /><figcaption>{n}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 3 · Dashboard -->
    <section id="dashboard">
      <div class="wrap">
        <p class="eyebrow">3 · Usage dashboard</p>
        <h2>Figures you can rely on, read directly from Anthropic</h2>
        <p class="lead">
          No estimates and no guesswork: for each account, cl_audit reads the usage limits directly from Anthropic,
          the same figures Claude shows in Settings ▸ Usage, with the exact reset times. Below them, your usage
          history shows when you use Claude, how many tokens each day, and which projects, models and apps they
          went to.
        </p>
        <div class="window" style="margin-top:28px">
          <div class="top">
            <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="title">cl_audit</span>
            <span class="chips hide-sm"><span class="lbl">Show</span>
              {accounts.map((a) => <span><span class="chip-ck" style={`background:${a.color}`}>✓</span> {a.name}</span>)}
            </span>
            <span class="updated hide-sm">Updated just now</span>
            <span class="spacer"></span>
            <span class="switch"><span class="on">Dashboard</span><span>Settings</span></span>
          </div>
          <div class="cards">
            {accounts.map((a) => <AccountCard {...a} />)}
          </div>
        </div>
        <div class="sources">
          <div class="card">
            <h4>Usage limits</h4>
            <p><b>Read directly from Anthropic</b> for each account, through that account's own Claude Code sign-in.
              The 5-hour session limit and the weekly limit, as percentages with reset times, refreshed every few
              minutes.</p>
          </div>
          <div class="card">
            <h4>Usage history</h4>
            <p><b>Read from the Claude Code session logs</b> already on your Mac: the terminal, the desktop app's Code
              tab, VS Code and Agent SDK apps. Tokens count input, cache writes and output, for the last 24 hours,
              7 days or 30 days.</p>
          </div>
          <div class="card">
            <h4>Nothing in between</h4>
            <p><b>No cl_audit server.</b> Sign-ins are read read-only from the macOS Keychain, the same way Claude
              Code reads them, and the only network requests go to Anthropic.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Install -->
    <section id="install">
      <div class="wrap grid2" style="align-items:start">
        <div>
          <p class="eyebrow">Install</p>
          <h2>Build it in a minute</h2>
          <p class="lead">cl_audit is built from source on your Mac, so you can read every line before it runs.</p>
          <div class="ctas"><a class="pill tint t-orange" href={repo}>Get the source</a></div>
        </div>
        <div class="card">
          <h4>Terminal</h4>
          <pre class="code"><code>git clone {repo}.git
cd cl_audit
./build.sh</code></pre>
          <div class="list" style="margin-top:6px">
            <div><b>Then</b><span>Open cl_audit, add your accounts with ＋, and drag their icons into the Dock.</span></div>
            <div><b>Requires</b><span>A Mac with Apple silicon and macOS 13 or later, the Xcode Command Line Tools (<code>xcode-select --install</code>), and Claude Code signed in for each account.</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <div class="wrap">
        <p class="eyebrow">Questions</p>
        <h2>Good to know</h2>
        <div class="faq">
          {faq.map(([q, a]) => (
            <details class="card"><summary>{q}</summary><p>{a}</p></details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span>cl_audit by <a href="https://n-uf.com">n-uf</a> · <a href={`${repo}/blob/main/LICENSE`}>PolyForm Perimeter 1.0.1</a> · <a href={repo}>GitHub</a></span>
      <span>Not affiliated with Anthropic. Claude is a trademark of Anthropic.</span>
    </div>
  </footer>
</Base>

<style>
  .hero { padding: 64px 0 40px; }
  h1 { font-size: clamp(34px, 5vw, 56px); line-height: 1.05; letter-spacing: -0.025em; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  .note { color: var(--faint); font-size: 13px; margin-top: 14px; }
  .palette { justify-self: end; }
  .anchors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 52px; }
  .anchor { display: grid; gap: 6px; align-content: start; text-decoration: none; transition: background .15s, transform .15s; }
  .anchor:hover { background: rgba(255,255,255,.06); transform: translateY(-2px); }
  .anchor b { font-size: 16px; }
  .anchor .sub { font-size: 14px; }
  .num { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: rgba(217,119,87,.22); box-shadow: inset 0 0 0 1px rgba(217,119,87,.6); font-size: 12px; font-weight: 700; }
  .sub-h { font-size: 20px; margin-top: 44px; margin-bottom: 6px; }
  .dock-wrap { display: grid; justify-items: center; margin-top: 32px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; padding: 16px; }
  .styles { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 8px; margin-top: 18px; }
  .style { margin: 0; display: grid; justify-items: center; gap: 6px; padding: 12px 6px 10px; border-radius: 14px; background: var(--card); box-shadow: inset 0 0 0 1px var(--line); color: var(--muted); font-size: 12.5px; text-align: center; }
  .style:hover { color: var(--text); background: rgba(255,255,255,.06); }
  .lane { margin-top: 16px; background: #3a3a3f; box-shadow: none; }
  .lane-bar { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; }
  .lane-bar i { height: 3px; border-radius: 2px; }
  .lane-icons { display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 10px; }
  .lane-icons figure { margin: 0; display: grid; justify-items: center; gap: 4px; color: var(--muted); font-size: 12px; min-height: 80px; }
  .panels { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; margin-top: 18px; align-items: start; }
  .panels figure { margin: 0; border-radius: 16px; background: var(--window); overflow: hidden; box-shadow: inset 0 0 0 1px var(--line); }
  .panels figcaption { padding: 0 16px 12px; color: var(--muted); font-size: 13px; }
  .sources { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 16px; }
  .sources p { color: var(--muted); font-size: 14px; }
  .sources b { color: var(--text); }
  .code { margin: 0; padding: 12px 14px; border-radius: 10px; background: rgba(0,0,0,.35); box-shadow: inset 0 0 0 1px var(--line); font-size: 13.5px; line-height: 1.7; overflow-x: auto; }
  .faq { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; margin-top: 24px; align-items: start; }
  .faq summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 10px; }
  .faq summary::after { content: "+"; color: var(--muted); }
  .faq details[open] summary::after { content: "−"; }
  .faq p { color: var(--soft); font-size: 14.5px; margin-top: 10px; }
  footer { border-top: 1px solid var(--divider); padding: 28px 0 40px; color: var(--muted); font-size: 13px; }
  footer .wrap { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 860px) {
    .palette { justify-self: stretch; max-width: none; }
    .anchors, .sources { grid-template-columns: 1fr; }
    .dock img { width: 52px; height: 52px; }
  }
</style>
