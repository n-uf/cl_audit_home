---
import Desktop from "../layouts/Desktop.astro";
import Row from "../components/Row.astro";
import AccountCard from "../components/AccountCard.astro";
import AccIcon from "../components/AccIcon.astro";
import { accounts } from "../data/demo";
import { repo, site, version, released, releasedText, changelog, download, requires, checkedWith, stage } from "../data/site";
import { cardLimitsHTML } from "../data/panelView";
import { getPosts, pathOf } from "../data/content";
import { orgNode, orgRef } from "../data/schema";

// "Guides" near the end: three articles, the most searched topics first (then the newest)
const featured = ["claude-usage-limits", "check-claude-usage-mac", "best-claude-usage-trackers-mac"];
const posts = await getPosts();
const guides = [...featured.map((id) => posts.find((p) => p.id === id)).filter((p) => p !== undefined), ...posts]
  .filter((p, i, all) => all.indexOf(p) === i).slice(0, 3);

// title and description: what a search result shows (Google cuts titles near 60 characters, descriptions near 155)
// main keyword: "Claude usage tracker" (the semantic core in /opt/projects/claude/seo maps one per page)
const title = "Claude usage tracker for Mac: all your accounts | cl_audit";
const description =
  "cl_audit is a free Claude usage tracker for Mac: each account's 5-hour and weekly limits on its own Dock icon and on one dashboard, plus usage history.";
// the fuller summary, for the structured data (not shown in search results)
const appDescription =
  "cl_audit is a free, source-available Claude usage tracker for Mac. It runs several Claude accounts side by side, each in its own profile: a Claude Code folder, an optional separate Claude window and a Dock icon that shows its 5-hour and weekly usage limits live. One dashboard shows every profile, with limits read from Anthropic and Claude Code usage history from local logs.";

// "At a glance": short facts under the intro (the key takeaways), each a lead word and a line
const glance: [string, string][] = [
  ["Free", "Source-available (PolyForm Perimeter 1.0.1). No sign-up, server or analytics."],
  ["Mac", "Apple silicon, macOS 13 or later. Claude Code signed in for each profile."],
  ["Plans", "Plans with usage limits, such as Pro, Max, Ultra and Team."],
  ["Accounts", "One profile per account seat, so work and personal sit side by side."],
  ...(stage ? [["Alpha", "First released October 2026. A Claude update can break it until cl_audit updates."] as [string, string]] : []),
  ["Independent", "Not affiliated with Anthropic."],
];

// Questions about tracking Claude usage (shown near the end, and the page's FAQPage data). Answers may hold <code>.
const homeFaq: [string, string][] = [
  ["How do I check my Claude usage on a Mac?",
   "Claude shows it in Settings ▸ Usage, and Claude Code shows it with <code>/usage</code>, one account at a time. cl_audit shows every account's 5-hour and weekly limits at once: on each profile's Dock icon, in the launcher and on one dashboard, with the exact reset times."],
  ["Can cl_audit track several Claude accounts?",
   "Yes. Each profile has its own accounts and can have its own Dock icon; the dashboard shows all of them. A profile can also keep a second account on standby, with its limits shown. A personal plan and a Team seat on the same email count as two accounts."],
  ["Is cl_audit a menu bar app?",
   "Mostly a Dock app: every profile with Usage in the Dock on gets its own Dock icon, so several accounts sit side by side. A profile can also have a menu bar icon of its own (off by default). The “Claude usage” widget shows every profile on the desktop or in Notification Center (macOS 14 or later)."],
  ["Which Claude plans does it work with?",
   "Plans with usage limits, such as Pro, Max, Ultra and Team, signed in to Claude Code. A profile that uses an API key has no limits to show."],
  ["Is cl_audit free?",
   "Yes. It's free and source-available under PolyForm Perimeter 1.0.1, with no sign-up, server or analytics. It isn't made by Anthropic and isn't affiliated with it."],
];
const plain = (html: string) => html.replace(/<[^>]+>/g, "");

// The login section on the Overview: tabs, each with a plain explanation (text may hold <code>).
const trustFacts: { tab: string; title: string; text: string }[] = [
  { tab: "Password never seen", title: "The password is never seen",
    text: "Sign-in happens in Claude's own screens: Claude Code's sign-in in Terminal (<code>claude auth login</code>) and the Claude app's sign-in window. cl_audit only opens them, so whatever is typed goes straight to Anthropic." },
  { tab: "Read-only, in memory", title: "The saved login is read-only, in memory",
    text: "Claude Code saves its login in the Mac's Keychain. cl_audit reads it the way Claude Code does, with Apple's <code>security</code> tool, so macOS asks nothing. It keeps only the short-lived part, in memory, and never writes, renews or logs it. Any app running as the same user could read it the same way; cl_audit doesn't change that." },
  { tab: "Sent only to Anthropic", title: "It is sent only to Anthropic",
    text: "The login is used for two requests to Anthropic's own server, <code>api.anthropic.com</code>: the 5-hour and weekly usage, and which account a profile is signed in to. Nothing else leaves the Mac." },
  { tab: "History stays local", title: "Usage history stays on the Mac",
    text: "The charts come from the session files Claude Code already writes on the Mac: only time, model, token counts, project folder and where Claude was used. Nothing is uploaded." },
  { tab: "No server or analytics", title: "No server, analytics or sign-up",
    text: "cl_audit has no server of its own, collects no statistics and needs no account. Its code is open: the login is read in <code>Login.read</code> (Sources/Model.swift)." },
];
const lane = ["plenty left", "", "half used", "", "at the limit"];
// The release display above the hero keys: three pages it steps through (a plain refresh, with page marks; a
// click moves on). A page longer than the window scrolls to its end first. Page 3 is a note, marked amber.
const relPages: { html: string; amber?: boolean }[] = [
  { html: `<span>cl_audit ${version}${stage ? ` ${stage}` : ""}</span> <em>·</em> <span>${releasedText()}</span> <em>·</em> <span class="sub">${requires}</span>` },
  { html: `<em>Checked with</em> <span>Claude Code ${checkedWith.claudeCode}</span> <em>·</em> <span>Claude app ${checkedWith.claudeApp}</span>` },
  { html: `<em class="amber">Note</em> <span class="sub">newer Claude versions may need a cl_audit update</span>`, amber: true },
];
// shown instead on a computer that isn't a Mac (or, where the browser can tell, an Intel Mac)
const relReason = {
  other: `<em class="amber">This computer isn't a Mac</em> <em>·</em> <span>cl_audit runs on macOS 13+, Apple silicon</span>`,
  intel: `<em class="amber">This Mac has an Intel chip</em> <em>·</em> <span>cl_audit needs Apple silicon</span>`,
};
const relText = `cl_audit ${version}${stage ? ` (${stage})` : ""} · ${releasedText()} · ${requires}. Checked with Claude Code ${checkedWith.claudeCode} and the Claude app ${checkedWith.claudeApp}. Newer Claude versions may need a cl_audit update.`;
const spark = [[10, 4, 6], [14, 2, 8], [6, 22, 3], [5, 24, 2], [7, 26, 4], [9, 20, 3], [3, 8, 1]];

// spellings people type for the name; "cl audit" alone also matches unrelated audit firms
const alternateName = ["cl-audit", "cl audit"];
// the n-uf Organization node first, on its own (the same id on every n-uf site, so search engines see one
// maker); the other nodes point to it by id
const jsonLd = [orgNode, {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}/#website`,
  name: "cl_audit",
  alternateName,
  url: `${site}/`,
  publisher: orgRef,
}, {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${site}/#webpage`,
  name: title,
  description,
  url: `${site}/`,
  isPartOf: { "@id": `${site}/#website` },
  about: { "@id": `${site}/#app` },
  publisher: orgRef,
}, {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  // the new use-case and blog pages point to the app by this id
  "@id": `${site}/#app`,
  name: "cl_audit",
  alternateName,
  description: appDescription,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 13 or later",
  softwareVersion: version,
  datePublished: released,
  dateModified: released,
  releaseNotes: changelog,
  url: `${site}/`,
  downloadUrl: download,
  image: `${site}/img/app-icon.png`,
  featureList: [
    "Several Claude accounts side by side: each profile with its own Claude Code folder and sign-in and, if you want, its own Claude window",
    "A Dock icon per profile with its 5-hour and weekly usage limits, counting down to the reset when a limit is full",
    "Notifications at a set level, when a limit is full and when it resets",
    "A dashboard with a card per profile: switches for its Claude window and Dock icon, limits read from Anthropic, Claude Code usage history",
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  author: orgRef,
  publisher: orgRef,
}, {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: plain(a) } })),
}];
---
<Desktop title={title} description={description} page="overview" headline="Claude usage tracker for Mac · every account's limits in the Dock" jsonLd={jsonLd}>
  <div class="content-inner">
    <div class="hero-row">
    <div class="hero-cards" aria-label="Two demo profiles as the dashboard shows them">
      {accounts.slice(0, 2).map((a) => <AccountCard {...a} />)}
    </div>
    <div class="card intro">
      <div class="intro-body intro-grid">
        <h4 class="intro-label">What it does</h4>
        <p class="intro-text"><img class="intro-ico" src="/img/app-icon.png" alt="The cl_audit app icon" width="72" height="72" />
          cl_audit is a free Claude usage tracker for Mac. It shows the 5-hour and weekly limits of every Claude
          account you use, each on its own Dock icon and all on one dashboard, and counts down to the reset when a
          limit is full. Each account can also have its own Claude window, side by side. Limits are read from
          Anthropic; usage history comes from Claude Code's session logs on the Mac.
        </p>
        <!-- the release in a display window, then the actions as one key strip (sketch T4); both full width -->
        <div class="disp version-disp" id="rel" title={relText} aria-hidden="true">
          <span class="rel-view"><span class="rel-line" set:html={relPages[0].html} /></span>
          <span class="rel-marks">{relPages.map((p, i) => <button type="button" tabindex="-1" class:list={["rel-mark", { on: i === 0, amber: p.amber }]} data-page={i} title={`Page ${i + 1}`}><i /></button>)}</span>
        </div>
        <p class="sr-only">{relText}</p>
        <script type="application/json" id="rel-data" set:html={JSON.stringify({ pages: relPages.map((p) => p.html), reason: relReason })} />
        <div class="plate hero-keys">
          <span class="lbl hk-ver" title={`cl_audit ${version}`}>{version}</span><span class="divider" aria-hidden="true"></span>
          <a class="pill dl big" href={download}><span class="dl-l">Download for Mac</span><span class="dl-na">Mac only</span></a>
          <a class="key" href="/install/">Install steps</a>
          <a class="key" href="/dashboard/" title="The dashboard with sample profiles">Demo dashboard</a>
        </div>
      </div>
    </div>
    </div>

    <!-- the short facts a search result or an AI answer can lift as they are -->
    <section class="card glance" aria-labelledby="glance-title">
      <h4 id="glance-title">At a glance</h4>
      <ul>
        {glance.map(([b, t]) => <li class:list={{ stage: b === "Alpha" }}><b>{b}</b>{t}</li>)}
      </ul>
    </section>

    <section class="card trust" aria-labelledby="trust-title">
      <div class="trust-head">
        <!-- a two-part display window: LOGIN dim, SECURITY lit (sketch V4) -->
        <span class="disp trust-disp" aria-hidden="true"><em>Login</em>Security</span>
        <h2 id="trust-title" class="trust-title">How does cl_audit handle your Claude login?</h2>
        <span class="trust-note">Source-available · runs locally · no account or server</span>
        <a class="trust-more" href={`${repo}#security-how-cl_audit-handles-the-claude-login`}>Details ›</a>
      </div>
      <!-- the tabs as on the production site: a dark track, plain-text tabs, one raised highlight that slides -->
      <div class="seg" role="tablist" aria-label="How cl_audit handles the Claude login">
        <span class="seg-ind" aria-hidden="true"></span>
        {trustFacts.map((f, i) => <button type="button" class="stab" role="tab" id={`tf-tab-${i}`} aria-controls="tf-pane" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-i={i}>{f.tab}</button>)}
      </div>
      <div class="tf-pane" id="tf-pane" role="tabpanel" aria-labelledby="tf-tab-0">
        <div class="tf-text"><b>{trustFacts[0].title}</b><p set:html={trustFacts[0].text} /></div>
      </div>
      <script type="application/json" id="tf-data" set:html={JSON.stringify(trustFacts)} />
    </section>

    <div class="cols3">
      <article class="card" id="profiles">
        <h4>1 · Multiple Claude accounts</h4>
        <h2 class="h3">Several Claude accounts, side by side</h2>
        <div class="mini-palette">
          {accounts.map((a, i) => <Row id={a.id} icon={a.icon} name={a.name} color={a.color} five={a.five} week={a.week} key={`⌘${i + 1}`} sel={i === 0} open={i < 2} />)}
          <div class="foot">click or ↩ Claude window · ⌘↩ Terminal</div>
        </div>
        <p class="t">
          The Claude app signs in to one account at a time, so every profile but the one using <code>~/.claude</code> gets
          its own Claude window, with its own sign-in, chats and settings; its Claude Code folder keeps its own
          sign-in. A personal plan and a Team seat on one email are two seats, so work and personal can each have a
          profile.
        </p>
        <a class="more" href="/use-cases/multiple-claude-accounts/">Multiple Claude accounts on one Mac ›</a>
        <a class="more" href="/install/">Add a profile ›</a>
      </article>

      <article class="card" id="dock">
        <h4>2 · Usage in the Dock</h4>
        <h2 class="h3">5-hour and weekly limits in the Dock, per account</h2>
        <div class="dock-mini">
          <img src="/img/app-icon.png" alt="" width="52" height="52" /><span class="vsep"></span>
          {accounts.map((a) => <AccIcon id={a.id} src={a.icon} size={52} alt={`Dock icon of the ${a.name} profile: ${a.five}% of the 5-hour limit used`} />)}
        </div>
        <div class="lane-mini">
          <div class="lane-bar"><i style="background:var(--green)"></i><i style="background:var(--green)"></i><i style="background:var(--amber)"></i><i style="background:var(--red)"></i><i style="background:var(--red)"></i></div>
          <div class="lane-icons">{lane.map((t, i) => <figure><img src={`/img/lane-${i}.png`} alt="" width="40" height="40" /><figcaption>{t}</figcaption></figure>)}</div>
        </div>
        <p class="t">
          Each profile's Dock icon shows its 5-hour and weekly limits. A click shows the usage for a moment, then
          opens its Claude window. While a limit is full, the icon counts down to when the profile is back. Options: 13 icon styles, 5 panel
          designs, a notification at a set level and another when the profile is back, a dot while its Claude window is open.
        </p>
        <a class="more" href="/use-cases/claude-usage-limit-alerts/">Usage limit notifications ›</a>
        <a class="more" href="/settings/">Icon styles in Settings ›</a>
      </article>

      <article class="card" id="dashboard">
        <h4>3 · Usage dashboard</h4>
        <h2 class="h3">Limits from Anthropic, history from local logs</h2>
        <div class="mcards">
          {accounts.map((a) => (
            <div class="mcard">
              <div class="mh"><span class="dot" style={`background:${a.color};width:7px;height:7px`}></span><b>{a.name}</b></div>
              <Fragment set:html={cardLimitsHTML(a.id, "segments")} />
            </div>
          ))}
        </div>
        <a class="hist-mini" href="/dashboard/">
          <span class="spark" aria-hidden="true">{spark.map(([a, b, c]) => <span><i style={`height:${a}px;background:var(--orange)`} /><i style={`height:${b}px;background:var(--teal)`} /><i style={`height:${c}px;background:var(--purple)`} /></span>)}</span>
          <span><b>Claude Code usage history</b><br /><span class="sub">when you use Claude · tokens per day · where they go</span></span>
        </a>
        <p class="t">
          The figures Claude shows in Settings ▸ Usage, with exact reset times, for every profile. History is read
          from Claude Code's session logs on the Mac; nothing is uploaded.
        </p>
        <a class="more" href="/use-cases/claude-code-usage-history/">Claude Code usage history ›</a>
        <a class="more" href="/dashboard/">Demo dashboard ›</a>
      </article>
    </div>

    <div class="cols2">
      <div class="card">
        <h4>Launcher</h4>
        <div class="list">
          <div><b>cl_audit icon</b><span>Lists every profile with both limits. Click or ⌘1–9 opens that profile's Claude window.</span></div>
          <div><b>⌘↩</b><span>Opens Terminal with Claude Code set to that profile's folder.</span></div>
          <div><b>Shared files</b><span>A new profile can share CLAUDE.md, agents, skills, commands or memory with another Claude Code folder. Sign-ins and usage stay separate.</span></div>
        </div>
      </div>
      <div class="card">
        <h4>Card switches</h4>
        <div class="list">
          <div><b>Claude window</b><span>Opens or quits the profile's Claude window.</span></div>
          <div><b>Dock icon</b><span>Starts or quits the profile's Dock icon. The Dock is not restarted. Usage and alerts carry on: cl_audit's background agent reads every profile.</span></div>
          <div><b>Usage only</b><span>A profile with no Dock icon and no Claude window: one display instead of the switches. Its usage still shows on the dashboard, in the launcher and in alerts.</span></div>
          <div><b>Limit full</b><span>The card says when the profile is back (in 1h 42m, back at 15:28), the Dock icon counts down, and an alert comes when it's back.</span></div>
          <div><b>Dock icon and Claude window</b><span>Profile settings. The Dock icon runs At login, With its window or When started. The Claude window can open and quit with the Dock icon.</span></div>
        </div>
        <a class="more" href="/dashboard/">Switches in the demo ›</a>
      </div>
    </div>

    <div class="cols2">
      <div class="card">
        <h4>Menu bar and widget</h4>
        <div class="list">
          <div><b>Menu bar icon</b><span>One per profile, off by default. It shows the limits as two bars, a ring or numbers, and the countdown while a limit is full. A click opens that profile's menu.</span></div>
          <div><b>Widget</b><span>“Claude usage”, for the desktop or Notification Center, in three sizes. It shows every profile's limits (macOS 14 or later).</span></div>
          <div><b>After a Claude update</b><span>Claude's quiet updates close every Claude window. cl_audit reopens the profile windows the update closed (not ones you closed), in the background.</span></div>
        </div>
        <a class="more" href="/settings/">Menu bar and widget in Settings ›</a>
      </div>
      <div class="card">
        <h4>Limits and cost</h4>
        <div class="list">
          <div><b>Fable's limit</b><span>Fable's own weekly limit (Max and Ultra plans, premium Team and Enterprise seats) shows as a third row, with its own alerts.</span></div>
          <div><b>Usage credits</b><span>While a profile spends them, its card says “Using usage credits · $4.20 spent”. An alert comes when it starts and when they run out.</span></div>
          <div><b>CSV and cost</b><span>The usage history saves as a CSV file. Its totals add what the same tokens would cost at API list prices. Not your bill.</span></div>
        </div>
        <a class="more" href="/dashboard/">The demo dashboard ›</a>
      </div>
    </div>

    <div class="cols2">
      <div class="card">
        <h4>Add a profile</h4>
        <div class="list">
          <div><b>Settings ▸ ＋ (New profile)</b><span>Pick its account: one already signed in to a Claude Code folder on this Mac, or sign in to another one in a new folder. Then switch Claude window and Usage in the Dock on or off.</span></div>
          <div><b>Quit the Claude app first</b><span>Only for a profile with a Claude window, and only until its folder exists. While it's open, the app writes its own sign-in and settings.</span></div>
          <div><b>Sign in</b><span>Claude Code first, then the profile's Claude window, both to the same claude.ai account. One profile per account.</span></div>
          <div><b>Dock icon</b><span>cl_audit installs it and puts it in the Dock. A profile without one still has its usage read.</span></div>
        </div>
      </div>
      <div class="card">
        <h4>Terms</h4>
        <div class="list">
          <div><b>Profile</b><span>One Claude setup in cl_audit: a Claude Code folder with its sign-in and, if you want them, a Claude window, a Dock icon and a menu bar icon.</span></div>
          <div><b>Account</b><span>A claude.ai account a profile uses. A profile works on one at a time and can keep others on standby; an account belongs to one profile. A personal plan and a Team seat on one email are two.</span></div>
          <div><b>Claude window · Dock icon</b><span>The profile's running Claude app, and its own small app that shows its usage.</span></div>
        </div>
      </div>
    </div>

    {guides.length > 0 && (
      <section class="card guides" aria-labelledby="guides-title">
        <h4>Guides</h4>
        <h2 id="guides-title" class="h3">From the blog</h2>
        <div class="list">
          {guides.map((g) => <div><a href={pathOf("blog", g.id)}><b>{g.data.h1}</b></a><span>{g.data.description}</span></div>)}
        </div>
        <a class="more" href="/blog/">All guides ›</a>
      </section>
    )}

    <section class="card home-faq" aria-labelledby="hfaq-title">
      <h4>Questions</h4>
      <h2 id="hfaq-title" class="h3">Questions about tracking Claude usage</h2>
      <div class="list">
        {homeFaq.map(([q, a]) => <div><h3 class="q">{q}</h3><span set:html={a} /></div>)}
      </div>
      <a class="more" href="/faq/">All questions ›</a>
    </section>

    <div class="start-row">
      <!-- two mirrored columns: label, a key with what it needs, then a box with the steps or the commands -->
      <div class="card start">
        <div class="start-grid">
          <h4 class="sg-h1">Install</h4>
          <h4 class="sg-h2">Or build from source</h4>
          <div class="sg-k1 key-note">
            <a class="pill dl dim" href={download}><span class="dl-l">Download for Mac</span><span class="dl-na">Mac only</span></a>
            <span class="divider" aria-hidden="true"></span>
            <span class="note">cl_audit {version} · {requires} · needs Claude Code (the Claude app's copy works as a fallback)</span>
          </div>
          <div class="sg-k2 key-note">
            <a class="key" href={repo}>GitHub</a>
            <span class="divider" aria-hidden="true"></span>
            <span class="note">needs the Xcode Command Line Tools</span>
          </div>
          <div class="sg-b1 start-box">
            <div><span class="sb-n">01</span><span>Unzip, move to Applications, open</span></div>
            <div><span class="sb-n">02</span><span>First launch: System Settings ▸ Privacy &amp; Security ▸ <b>Open Anyway</b></span></div>
            <div><span class="sb-n">03</span><span><b>Set up cl_audit</b>: Claude Code, the account, a name</span></div>
          </div>
          <pre class="sg-b2 code"><code>git clone {repo}.git
cd cl_audit && ./build.sh</code></pre>
        </div>
      </div>
    </div>

    <p class="legal">cl_audit {version} · {releasedText()} · <a href={changelog}>What's new</a> · by <a href="https://n-uf.com">n-uf</a> · <a href={`${repo}/blob/main/LICENSE`}>PolyForm Perimeter 1.0.1</a> · Not affiliated with Anthropic. Claude is a trademark of Anthropic.</p>
  </div>
</Desktop>

<script>
  // The login section: tabs with a sliding highlight (as on the production site); the explanation
  // cross-fades in the readout below, which keeps the height of its longest explanation, so the page never
  // moves. Arrow keys move between tabs.
  function setupTrust() {
    const card = document.querySelector<HTMLElement>(".card.trust");
    if (!card || card.dataset.ready) return;
    card.dataset.ready = "1";
    const facts = JSON.parse(document.getElementById("tf-data")!.textContent || "[]") as { tab: string; title: string; text: string }[];
    const seg = card.querySelector<HTMLElement>(".seg")!, ind = card.querySelector<HTMLElement>(".seg-ind")!;
    const tabs = [...card.querySelectorAll<HTMLButtonElement>(".stab")];
    const pane = card.querySelector<HTMLElement>(".tf-pane")!, text = card.querySelector<HTMLElement>(".tf-text")!;
    const html = (i: number) => `<b>${facts[i].title}</b><p>${facts[i].text}</p>`;
    let cur = 0, timer = 0;
    const place = () => { const b = tabs[cur]; ind.style.width = `${b.offsetWidth}px`; ind.style.transform = `translateX(${b.offsetLeft}px)`; };
    const measure = () => {
      const keep = text.innerHTML; let h = 0;
      facts.forEach((_, i) => { text.innerHTML = html(i); h = Math.max(h, text.offsetHeight); });
      text.innerHTML = keep; pane.style.minHeight = `${h}px`;
    };
    const pick = (i: number, focus = false) => {
      if (i === cur) return;
      cur = i;
      tabs.forEach((b, k) => { b.setAttribute("aria-selected", String(k === i)); b.tabIndex = k === i ? 0 : -1; });
      pane.setAttribute("aria-labelledby", tabs[i].id);
      place();
      if (focus) {
        tabs[i].focus({ preventScroll: true });
        // on a phone the track scrolls sideways: bring the tab into view inside it, never scroll the page
        const b = tabs[i];
        if (b.offsetLeft < seg.scrollLeft || b.offsetLeft + b.offsetWidth > seg.scrollLeft + seg.clientWidth) seg.scrollTo({ left: b.offsetLeft - 8 });
      }
      clearTimeout(timer);
      text.classList.add("fade");
      timer = window.setTimeout(() => { text.innerHTML = html(i); text.classList.remove("fade"); }, 120);
    };
    tabs.forEach((b, k) => b.addEventListener("click", () => pick(k)));
    seg.addEventListener("keydown", (e) => {
      const d = ({ ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 } as Record<string, number>)[e.key];
      if (!d) return;
      e.preventDefault();
      pick((cur + d + tabs.length) % tabs.length, true);
    });
    new ResizeObserver(() => { place(); measure(); }).observe(seg);
    place(); measure();
  }
  document.addEventListener("astro:page-load", setupTrust);

  // The release display: shows a page; a page wider than the window waits, scrolls steadily to its end and waits
  // again; then a plain refresh to the next page. The pointer over it holds it; a click moves on at once. With
  // "reduce motion" nothing scrolls (the full text is in the tooltip and for screen readers).
  // The page changes only after a long page has scrolled to its end.
  function setupRel() {
    const el = document.getElementById("rel");
    if (!el || el.dataset.ready) return;
    el.dataset.ready = "1";
    const data = JSON.parse(document.getElementById("rel-data")?.textContent || "{}") as { pages: string[]; reason: Record<string, string> };
    // on a computer that isn't a Mac the display shows only the reason (see Base.astro)
    const notMac = () => document.documentElement.classList.contains("not-mac");
    let pages = data.pages;
    const choose = () => { pages = notMac() ? [data.reason[document.documentElement.dataset.sys || "other"] ?? data.reason.other] : data.pages; };
    choose();
    const view = el.querySelector<HTMLElement>(".rel-view")!, marks = [...el.querySelectorAll<HTMLElement>(".rel-mark")];
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const SPEED = 45, WAIT_START = 1200, WAIT_END = 2500, HOLD = [6000, 4500, 4500];
    let i = 0, timer = 0, run = 0, hold = false;
    const later = (ms: number, fn: () => void) => { clearTimeout(timer); timer = window.setTimeout(() => (hold ? later(ms, fn) : fn()), ms); };
    const show = (k: number) => {
      const r = ++run;
      i = k;
      el.classList.add("blank");
      window.setTimeout(() => {
        if (r !== run || !el.isConnected) return;
        view.innerHTML = `<span class="rel-line">${pages[i]}</span>`;
        marks.forEach((m, n) => m.classList.toggle("on", n === i));
        el.classList.remove("blank");
        const line = view.firstElementChild as HTMLElement;
        const over = line.offsetWidth - view.clientWidth;
        const next = () => { if (r === run && el.isConnected) show((i + 1) % pages.length); };
        // the current mark drains like a countdown to the next page
        const countdown = (ms: number) => { const m = marks[i]; if (!m) return; m.style.setProperty("--d", `${ms}ms`); m.classList.remove("counting"); void m.offsetWidth; m.classList.add("counting"); };
        if (over <= 0 || still) { countdown(HOLD[i] ?? 4500); return later(HOLD[i] ?? 4500, next); }
        countdown(WAIT_START + (over / SPEED) * 1000 + WAIT_END);
        // a page that doesn't fit always scrolls to its end (the pointer over the display only holds the page change)
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (r !== run || !el.isConnected) return;
          const t = over / SPEED;
          line.style.setProperty("--t", `${t}s`);
          line.classList.add("scroll");
          line.style.transform = `translateX(${-over}px)`;
          later(t * 1000 + WAIT_END, next);
        }, WAIT_START);
      }, k === i && !el.dataset.started ? 0 : 120);
      el.dataset.started = "1";
    };
    // a page mark is a small key: it shows that page at once
    marks.forEach((m) => m.addEventListener("click", (e) => { e.stopPropagation(); show(+(m.dataset.page || 0)); }));
    el.addEventListener("mouseenter", () => (hold = true));
    el.addEventListener("mouseleave", () => (hold = false));
    el.addEventListener("click", () => show((i + 1) % pages.length));
    // the window's width changes with the layout (resizing, rotating a tablet): measure the current page again, so a
    // page that no longer fits starts scrolling (and one that fits again stops)
    // (waits until resizing has stopped, so dragging a window edge doesn't keep restarting the page)
    let lastW = view.clientWidth, settle = 0;
    new ResizeObserver(() => {
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        if (!el.isConnected || Math.abs(view.clientWidth - lastW) < 2) return;
        lastW = view.clientWidth;
        clearTimeout(timer);
        show(i);
      }, 300);
    }).observe(view);
    document.addEventListener("cl:platform", () => { choose(); show(0); });
    show(0);
  }
  document.addEventListener("astro:page-load", setupRel);
</script>

