---
import Desktop from "../layouts/Desktop.astro";
import Row from "../components/Row.astro";
import { accounts } from "../data/demo";
import { repo, site } from "../data/site";
import { level, levelColor, segments } from "../components/level";

const title = "cl_audit — run several Claude accounts on macOS, with usage limits in the Dock";
const description =
  "cl_audit runs a separate Claude desktop app for each of your Claude accounts on macOS, shows each account's usage limits live in the Dock, and keeps a usage dashboard with figures read directly from Anthropic. Free and source-available.";

const lane = ["plenty left", "", "half used", "", "at the limit"];
const spark = [[10, 4, 6], [14, 2, 8], [6, 22, 3], [5, 24, 2], [7, 26, 4], [9, 20, 3], [3, 8, 1]];

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "cl_audit",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 13 or later",
  url: `${site}/`,
  downloadUrl: repo,
  image: `${site}/img/app-icon.png`,
  featureList: [
    "Several Claude accounts side by side: a separate Claude desktop app per account",
    "Usage limits for every account in the macOS Dock",
    "A usage dashboard with limits read directly from Anthropic",
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: "n-uf", url: "https://n-uf.com" },
}];
---
<Desktop title={title} description={description} page="overview" jsonLd={jsonLd}>
  <div class="content-inner">
    <div class="card intro">
      <img src="/img/app-icon.png" alt="The cl_audit app icon" width="92" height="92" />
      <div>
        <h1>Every Claude account, side by side on your Mac.</h1>
        <p>
          cl_audit runs a separate Claude desktop app for each of your accounts, shows each account's usage limits
          live in the Dock, and keeps a usage dashboard with figures read directly from Anthropic.
        </p>
        <div class="btns">
          <a class="pill tint t-orange" href="/install/">Install</a>
          <a class="pill" href="/dashboard/">Open the dashboard</a>
          <span class="note">Free · source-available · runs entirely on your Mac</span>
        </div>
      </div>
    </div>

    <div class="cols3">
      <article class="card" id="accounts">
        <h4>1 · Several Claude accounts</h4>
        <h2 class="h3">Side by side, each signed in</h2>
        <div class="mini-palette">
          {accounts.map((a, i) => <Row icon={a.icon} name={a.name} color={a.color} five={a.five} week={a.week} key={`⌘${i + 1}`} sel={i === 0} open={i < 2} />)}
          <div class="foot">click or ↩ desktop app · ⌘↩ Terminal</div>
        </div>
        <p class="t">
          The Claude desktop app signs in to one account at a time. cl_audit starts a separate instance for each
          account, with its own sign-in, and the Code tab and Claude Code CLI use that account's own configuration
          directory.
        </p>
        <a class="more" href="/install/">Set up your accounts ›</a>
      </article>

      <article class="card" id="dock">
        <h4>2 · Usage limits in the Dock</h4>
        <h2 class="h3">One glance per account</h2>
        <div class="dock-mini">
          <img src="/img/app-icon.png" alt="" width="52" height="52" /><span class="vsep"></span>
          {accounts.map((a) => <img src={a.icon} alt={`${a.name}: ${a.five}% of the 5-hour session limit used`} width="52" height="52" />)}
        </div>
        <div class="lane-mini">
          <div class="lane-bar"><i style="background:var(--green)"></i><i style="background:var(--green)"></i><i style="background:var(--amber)"></i><i style="background:var(--red)"></i><i style="background:var(--red)"></i></div>
          <div class="lane-icons">{lane.map((t, i) => <figure><img src={`/img/lane-${i}.png`} alt="" width="40" height="40" /><figcaption>{t}</figcaption></figure>)}</div>
        </div>
        <p class="t">
          Each account's icon shows its 5-hour session limit and weekly limit. Click it for a quick look while that
          account's Claude opens; 13 icon styles, 5 panel designs, and a notification before a limit is reached.
        </p>
        <a class="more" href="/settings/">Icon styles in Settings ›</a>
      </article>

      <article class="card" id="dashboard">
        <h4>3 · Usage dashboard</h4>
        <h2 class="h3">Read directly from Anthropic</h2>
        <div class="mcards">
          {accounts.map((a) => (
            <div class="mcard">
              <div class="mh"><span class="dot" style={`background:${a.color};width:7px;height:7px`}></span><b>{a.name}</b><span class="pct" style={`color:${levelColor(a.five)}`}>{a.five}%</span></div>
              <div class="seg">{segments(a.five).map((c) => <i class={c} />)}</div>
              <div class="mh2"><span>Week</span><span class={`lv-${level(a.week)}`} style="font-weight:700">{a.week}%</span></div>
              <div class="seg">{segments(a.week).map((c) => <i class={c} />)}</div>
            </div>
          ))}
        </div>
        <a class="hist-mini" href="/dashboard/">
          <span class="spark" aria-hidden="true">{spark.map(([a, b, c]) => <span><i style={`height:${a}px;background:var(--orange)`} /><i style={`height:${b}px;background:var(--teal)`} /><i style={`height:${c}px;background:var(--purple)`} /></span>)}</span>
          <span><b>Usage history</b><br /><span class="sub">when you use Claude · tokens per day · where they go</span></span>
        </a>
        <p class="t">
          The same figures Claude shows in Settings ▸ Usage, with exact reset times, for every account. History comes
          from the Claude Code session logs on your Mac.
        </p>
        <a class="more" href="/dashboard/">Open the dashboard ›</a>
      </article>
    </div>

    <div class="cols2">
      <div class="card">
        <h4>Open the right account</h4>
        <div class="list">
          <div><b>Click the cl_audit icon</b><span>The launcher lists every account with both limits. Click one, or press ⌘1–9, to bring up its Claude desktop app.</span></div>
          <div><b>⌘↩ for Claude Code</b><span>Opens Terminal with Claude Code already set to that account.</span></div>
          <div><b>Shared where you want it</b><span>CLAUDE.md, agents, skills and commands can be linked from your main account, while sign-ins and usage stay separate.</span></div>
        </div>
      </div>
      <div class="card">
        <h4>Add an account</h4>
        <div class="list">
          <div><b>✓ Create the folders and links</b><span>A Claude Code configuration directory and a desktop app data folder for the account.</span></div>
          <div><b>✓ Sign in to Claude Code</b><span>The step turns green once the account is signed in, and warns if another account already uses the same sign-in.</span></div>
          <div><b>○ Open the Claude desktop app</b><span>Its own instance with its own sign-in. Optional if you only use Claude Code in the terminal.</span></div>
          <div><b>○ Add the Dock icon</b><span>Finish adds the account and installs its icon.</span></div>
        </div>
      </div>
    </div>

    <div class="cols2">
      <div class="card">
        <h4>Privacy</h4>
        <div class="srow"><span>Sign-ins</span><span class="v">read-only from the macOS Keychain</span></div>
        <div class="srow"><span>Network</span><span class="v">Anthropic only, every few minutes</span></div>
        <div class="srow"><span>Usage history</span><span class="v">Claude Code session logs on your Mac</span></div>
        <div class="srow"><span>Server, analytics, account</span><span class="v">none</span></div>
      </div>
      <div class="card">
        <h4>Get started</h4>
        <pre class="code"><code>git clone {repo}.git
cd cl_audit && ./build.sh</code></pre>
        <div class="srow" style="margin-top:6px"><span>Requires</span><span class="v">Apple silicon · macOS 13+ · Claude Code</span></div>
        <a class="more" href="/install/">Full install steps ›</a>
      </div>
    </div>

    <p class="legal">cl_audit by <a href="https://n-uf.com">n-uf</a> · <a href={`${repo}/blob/main/LICENSE`}>PolyForm Perimeter 1.0.1</a> · Not affiliated with Anthropic. Claude is a trademark of Anthropic.</p>
  </div>
</Desktop>

<style>
  .h3 { font-size: 18px; margin-bottom: 12px; }
  .lane-icons { display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 6px; }
  .lane-icons figure { margin: 0; display: grid; justify-items: center; gap: 2px; color: var(--muted); font-size: 10.5px; min-height: 58px; }
  .lane-mini { margin-top: 10px; }
</style>
