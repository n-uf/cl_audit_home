---
import Desktop from "../layouts/Desktop.astro";
import Row from "../components/Row.astro";
import AccountCard from "../components/AccountCard.astro";
import AccIcon from "../components/AccIcon.astro";
import { accounts } from "../data/demo";
import { repo, site, version, released, releasedText, changelog, download, requires, checkedWith, driftNote } from "../data/site";
import { cardLimitsHTML } from "../data/panelView";

const title = "cl_audit — run several Claude profiles on macOS, with usage limits in the Dock";
const description =
  "cl_audit gives each of your Claude setups on macOS its own profile: a Claude Code folder, an optional separate Claude window and a Dock icon that shows its usage limits live. One dashboard with switches for every profile, figures read directly from Anthropic. Free and source-available.";

// The login strip on the Overview: each point opens a plain explanation.
const trustFacts: [string, string][] = [
  ["Password never seen: Claude's own sign-in",
   "You sign in through Claude's own screens: Claude Code's sign-in in Terminal (claude auth login) and the Claude app's sign-in window. cl_audit only opens them, so whatever you type goes straight to Anthropic."],
  ["Login read-only, kept in memory",
   "After you sign in, Claude Code saves its login in your Mac's Keychain. cl_audit reads it the same way Claude Code does, with Apple's security tool, so macOS asks nothing. It keeps only the short-lived part, in memory, and never writes, renews or logs it. Any app running as you could read it the same way; cl_audit doesn't change that."],
  ["Sent only to Anthropic",
   "cl_audit uses the login for two requests to Anthropic's own server, api.anthropic.com: your 5-hour and weekly usage, and which account a profile is signed in to. Nothing else leaves your Mac."],
  ["History from Claude Code's logs on your Mac",
   "The usage charts come from the session files Claude Code already writes on your Mac: only the time, model, token counts, project folder and where you used Claude. Nothing is uploaded."],
  ["No server, analytics or sign-up",
   "cl_audit has no server of its own, collects no statistics and needs no account. Its code is open: how it reads your login is in Login.read (Sources/Model.swift)."],
];
const lane = ["plenty left", "", "half used", "", "at the limit"];
const spark = [[10, 4, 6], [14, 2, 8], [6, 22, 3], [5, 24, 2], [7, 26, 4], [9, 20, 3], [3, 8, 1]];

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "cl_audit",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 13 or later",
  softwareVersion: version,
  datePublished: released,
  dateModified: released,
  releaseNotes: changelog,
  url: `${site}/`,
  downloadUrl: download,
  image: `${site}/img/app-icon.png`,
  featureList: [
    "Several Claude profiles side by side: each with its own Claude Code folder and sign-in and, if you want, its own Claude window",
    "A Dock icon per profile with its 5-hour and weekly usage limits",
    "A dashboard with a card per profile: switches for its Claude window and Dock icon, limits read directly from Anthropic, usage history",
  ],
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: "n-uf", url: "https://n-uf.com" },
}];
---
<Desktop title={title} description={description} page="overview" jsonLd={jsonLd}>
  <div class="content-inner">
    <div class="hero-row">
    <div class="hero-cards" aria-label="Two demo profiles as the dashboard shows them">
      {accounts.slice(0, 2).map((a) => <AccountCard {...a} />)}
    </div>
    <div class="card intro">
      <img src="/img/app-icon.png" alt="The cl_audit app icon" width="92" height="92" />
      <div>
        <h1>Every Claude profile, side by side on your Mac.</h1>
        <p>
          A profile is one Claude setup: its Claude Code folder and sign-in, its Claude window and its Dock icon.
          cl_audit shows each profile's usage limits live in the Dock and on a dashboard, with figures read
          directly from Anthropic.
        </p>
        <div class="btns">
          <a class="pill dl big" href={download}><span aria-hidden="true">↓</span> Download for Mac</a>
          <a class="pill" href="/install/">Install steps</a>
          <a class="pill quiet" href="/dashboard/">Open the dashboard</a>
        </div>
        <span class="note dl-note">cl_audit {version} · {releasedText()} · {requires} · free and source-available · runs entirely on your Mac</span>
        <span class="note dl-note checked" title={driftNote}>Checked with Claude Code {checkedWith.claudeCode} and the Claude app {checkedWith.claudeApp}. Newer Claude versions may need a cl_audit update.</span>
      </div>
    </div>
    </div>

    <section class="card trust" id="login" aria-labelledby="trust-title">
      <div class="trust-head">
        <span class="trust-badge" aria-hidden="true"><svg width="12" height="13" viewBox="0 0 20 22"><rect x="2" y="9" width="16" height="12" rx="3" fill="currentColor"/><path d="M6 9V6.5a4 4 0 0 1 8 0V9" fill="none" stroke="currentColor" stroke-width="2.6"/></svg></span>
        <h2 id="trust-title" class="trust-title">Your Claude login stays with Claude</h2>
        <a class="trust-more" href={`${repo}#your-claude-login`}>How it works ›</a>
      </div>
      <ul class="trust-chips">
        {trustFacts.map(([short], i) => (
          <li><button type="button" class="tf" data-tf={i} aria-expanded="false" aria-controls="tf-panel">
            <svg class="tf-check" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.2 6.4l2.4 2.4 5.2-5.6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>{short}
            <svg class="tf-chev" width="9" height="9" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 3.8L5 6.3l2.5-2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button></li>
        ))}
      </ul>
      <div class="tf-panel" id="tf-panel" aria-live="polite"><div class="tf-clip"><div class="tf-body"><b data-tf-title></b><p data-tf-text></p></div></div></div>
      <script type="application/json" id="tf-data" set:html={JSON.stringify(trustFacts)} />
    </section>

    <div class="cols3">
      <article class="card" id="profiles">
        <h4>1 · Several Claude profiles</h4>
        <h2 class="h3">Side by side, each signed in</h2>
        <div class="mini-palette">
          {accounts.map((a, i) => <Row id={a.id} icon={a.icon} name={a.name} color={a.color} five={a.five} week={a.week} key={`⌘${i + 1}`} sel={i === 0} open={i < 2} />)}
          <div class="foot">click or ↩ Claude window · ⌘↩ Terminal</div>
        </div>
        <p class="t">
          The Claude app signs in to one account at a time. A profile can have a separate Claude window, with its
          own sign-in and data folder, next to the standard one; its Claude Code folder keeps its own sign-in
          too. Several profiles can use one claude.ai account.
        </p>
        <a class="more" href="/install/">Add a profile ›</a>
      </article>

      <article class="card" id="dock">
        <h4>2 · Usage limits in the Dock</h4>
        <h2 class="h3">One glance per profile</h2>
        <div class="dock-mini">
          <img src="/img/app-icon.png" alt="" width="52" height="52" /><span class="vsep"></span>
          {accounts.map((a) => <AccIcon id={a.id} src={a.icon} size={52} alt={`Dock icon of the ${a.name} profile: ${a.five}% of the 5-hour limit used`} />)}
        </div>
        <div class="lane-mini">
          <div class="lane-bar"><i style="background:var(--green)"></i><i style="background:var(--green)"></i><i style="background:var(--amber)"></i><i style="background:var(--red)"></i><i style="background:var(--red)"></i></div>
          <div class="lane-icons">{lane.map((t, i) => <figure><img src={`/img/lane-${i}.png`} alt="" width="40" height="40" /><figcaption>{t}</figcaption></figure>)}</div>
        </div>
        <p class="t">
          Each profile's Dock icon shows its 5-hour limit and weekly limit. Click it for a quick look while that
          profile's Claude window opens; 13 icon styles, 5 panel designs, a notification before a limit is
          reached and an optional dot while its Claude window is open.
        </p>
        <a class="more" href="/settings/">Icon styles in Settings ›</a>
      </article>

      <article class="card" id="dashboard">
        <h4>3 · Usage dashboard</h4>
        <h2 class="h3">Read directly from Anthropic</h2>
        <div class="mcards">
          {accounts.map((a) => (
            <div class="mcard">
              <div class="mh"><span class="dot" style={`background:${a.color};width:7px;height:7px`}></span><b>{a.name}</b></div>
              <Fragment set:html={cardLimitsHTML(a.id, "segments")} />
            </div>
          ))}
        </div>
        <a class="hist-mini" href="/dashboard/">
          <span class="spark" aria-hidden="true">{spark.map(([a, b, c]) => <span><i style={`height:${a}px;background:var(--orange)`} /><i style={`height:${b}px;background:var(--teal)`} /><i style={`height:${c}px;background:var(--purple)`} /></span>)}</span>
          <span><b>Usage history</b><br /><span class="sub">when you use Claude · tokens per day · where they go</span></span>
        </a>
        <p class="t">
          The same figures Claude shows in Settings ▸ Usage, with exact reset times, for every profile. History comes
          from the Claude Code session logs on your Mac.
        </p>
        <a class="more" href="/dashboard/">Open the dashboard ›</a>
      </article>
    </div>

    <div class="cols2">
      <div class="card">
        <h4>Open the right profile</h4>
        <div class="list">
          <div><b>Click the cl_audit icon</b><span>The launcher lists every profile with both limits. Click one, or press ⌘1–9, to open its Claude window.</span></div>
          <div><b>⌘↩ for Claude Code</b><span>Opens Terminal with Claude Code already set to that profile's folder.</span></div>
          <div><b>Shared where you want it</b><span>A new profile can share CLAUDE.md, agents, skills, commands or memory with another Claude Code folder, while sign-ins and usage stay separate.</span></div>
        </div>
      </div>
      <div class="card">
        <h4>Two switches on every card</h4>
        <div class="list">
          <div><b>Claude window</b><span>Open or quit the profile's Claude window.</span></div>
          <div><b>Dock icon</b><span>Start or quit the profile's Dock icon. The Dock is never restarted, but while the icon is stopped the profile doesn't refresh or alert.</span></div>
          <div><b>Following each other</b><span>In a profile's settings, Opening and closing lets the Dock icon follow its window, the window follow its Dock icon, or both.</span></div>
        </div>
        <a class="more" href="/dashboard/">Try the switches ›</a>
      </div>
    </div>

    <div class="cols2">
      <div class="card">
        <h4>Add a profile</h4>
        <div class="list">
          <div><b>Settings ▸ New profile</b><span>Choose a new or existing Claude Code folder, and its Claude window: standard, separate or none.</span></div>
          <div><b>Quit the Claude app first</b><span>Until the folder exists: while open, the app writes its own sign-in and settings.</span></div>
          <div><b>Sign in, in two parts</b><span>Claude Code first, then a separate window, signed in to the same claude.ai account.</span></div>
          <div><b>Its Dock icon</b><span>cl_audit installs and starts it. Drag it into the Dock, or let General settings ▸ Dock pin it (experimental).</span></div>
        </div>
      </div>
      <div class="card">
        <h4>Words used here</h4>
        <div class="list">
          <div><b>Profile</b><span>One Claude setup in cl_audit: a Claude Code folder with its sign-in, a Claude window and a Dock icon.</span></div>
          <div><b>Account</b><span>Only the claude.ai account a profile is signed in to. Several profiles can use one account.</span></div>
          <div><b>Claude window · Dock icon</b><span>The profile's running Claude app, and its own small app that shows its usage.</span></div>
        </div>
      </div>
    </div>

    <div class="start-row">
      <div class="card">
        <h4>Get started</h4>
        <div class="btns" style="margin:2px 0 8px"><a class="pill dl dim" href={download}><span aria-hidden="true">↓</span> Download cl_audit {version}</a></div>
        <p class="t">Unzip, move it to Applications and open it; the first time, allow it once in Privacy &amp; Security. Or build it yourself:</p>
        <pre class="code"><code>git clone {repo}.git
cd cl_audit && ./build.sh</code></pre>
        <div class="srow" style="margin-top:6px"><span>Requires</span><span class="v">{requires} · Claude Code</span></div>
        <a class="more" href="/install/">Full install steps ›</a>
      </div>
    </div>

    <p class="legal">cl_audit {version} · {releasedText()} · <a href={changelog}>What's new</a> · by <a href="https://n-uf.com">n-uf</a> · <a href={`${repo}/blob/main/LICENSE`}>PolyForm Perimeter 1.0.1</a> · Not affiliated with Anthropic. Claude is a trademark of Anthropic.</p>
  </div>
</Desktop>

<script>
  // The login strip: a click on a point expands the strip with its explanation; again, or Esc, collapses it.
  function setupTrust() {
    const card = document.getElementById("login");
    if (!card || card.dataset.ready) return;
    card.dataset.ready = "1";
    const facts = JSON.parse(document.getElementById("tf-data")!.textContent || "[]") as [string, string][];
    const panel = card.querySelector<HTMLElement>(".tf-panel")!;
    const body = card.querySelector<HTMLElement>(".tf-body")!;
    let open: HTMLElement | null = null;
    const fill = (i: number) => {
      body.querySelector("[data-tf-title]")!.textContent = facts[i][0];
      body.querySelector("[data-tf-text]")!.textContent = facts[i][1];
    };
    const close = () => { panel.classList.remove("open"); open?.setAttribute("aria-expanded", "false"); open = null; };
    const show = (b: HTMLElement) => {
      const i = +b.dataset.tf!;
      if (open) {                       // already open: swap the text with a short fade
        body.classList.add("swap");
        setTimeout(() => { fill(i); body.classList.remove("swap"); }, 120);
      } else fill(i);
      open?.setAttribute("aria-expanded", "false");
      b.setAttribute("aria-expanded", "true");
      open = b;
      panel.classList.add("open");
    };
    card.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>(".tf");
      if (b) b === open ? close() : show(b);
    });
    card.addEventListener("keydown", (e) => { if (e.key === "Escape" && open) { const b = open; close(); b.focus(); } });
  }
  document.addEventListener("astro:page-load", setupTrust);
</script>

<style>
  .pill.big { padding: 10px 20px; font-size: 15.5px; }
  .dl-note { display: block; color: var(--muted); font-size: 12.5px; }
  .dl-note.checked { margin-top: 2px; cursor: help; }
  /* the login card: a quiet strip of points; a point expands the strip with its explanation */
  .trust { padding: 14px 16px 12px; background: linear-gradient(90deg, rgba(34,197,94,.07), rgba(34,197,94,.02) 60%), var(--card, rgba(255,255,255,.04));
    box-shadow: inset 0 0 0 1px rgba(34,197,94,.22); }
  .trust-head { display: flex; align-items: center; gap: 10px; }
  .trust-badge { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; flex: none;
    color: #4ade80; background: rgba(34,197,94,.14); box-shadow: inset 0 0 0 1px rgba(34,197,94,.35); }
  .trust-title { margin: 0; font-size: 15px; font-weight: 650; letter-spacing: -.005em; color: var(--text); }
  .trust-more { margin-left: auto; font-size: 12.5px; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .trust-more:hover { color: #4ade80; }
  .trust-chips { list-style: none; margin: 11px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 7px; }
  .tf { display: inline-flex; align-items: center; gap: 7px; padding: 5px 10px 5px 9px; border: 0; border-radius: 99px; cursor: pointer;
    font: inherit; font-size: 13px; line-height: 1.3; color: rgba(255,255,255,.82); text-align: left;
    background: rgba(255,255,255,.05); box-shadow: inset 0 0 0 1px rgba(255,255,255,.09); transition: background .15s, box-shadow .15s, color .15s; }
  .tf:hover { background: rgba(255,255,255,.09); color: #fff; }
  .tf:focus-visible { outline: 2px solid #4ade80; outline-offset: 2px; }
  .tf-check { color: #4ade80; flex: none; }
  .tf-chev { color: var(--muted); flex: none; transition: transform .2s; }
  .tf[aria-expanded="true"] { background: rgba(34,197,94,.14); box-shadow: inset 0 0 0 1px rgba(34,197,94,.45); color: #fff; }
  .tf[aria-expanded="true"] .tf-chev { transform: rotate(180deg); color: #4ade80; }
  /* expands smoothly to its content's height */
  .tf-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .22s ease; }
  .tf-panel.open { grid-template-rows: 1fr; }
  .tf-clip { overflow: hidden; min-height: 0; }
  .tf-body { margin-top: 11px; padding: 10px 14px; border-radius: 10px; max-width: 820px;
    background: rgba(0,0,0,.18); box-shadow: inset 2px 0 0 #4ade80, inset 0 0 0 1px rgba(255,255,255,.06);
    font-size: 13.5px; line-height: 1.55; transition: opacity .15s; }
  .tf-body b { display: block; margin-bottom: 2px; color: var(--text); font-weight: 600; }
  .tf-body p { margin: 0; color: var(--muted); }
  .tf-body.swap { opacity: 0; }
  @media (max-width: 520px) {
    .trust-head { flex-wrap: wrap; row-gap: 2px; }
    .trust-more { margin-left: 34px; flex-basis: 100%; }
    .trust-chips li { width: 100%; }
    .tf { width: 100%; }
    .tf-chev { margin-left: auto; }
  }
  .start-row { display: grid; grid-template-columns: minmax(0, 1fr); max-width: 720px; }
  .h3 { font-size: 18px; margin-bottom: 12px; }
  .lane-icons { display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 6px; }
  .lane-icons figure { margin: 0; display: grid; justify-items: center; gap: 2px; color: var(--muted); font-size: 10.5px; min-height: 58px; }
  .lane-mini { margin-top: 10px; }
  /* top row: two profile cards on the left, the intro on the right */
  .hero-row { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 14px; align-items: stretch; }
  .hero-cards { display: grid; grid-template-columns: repeat(2, minmax(352px, 372px)); gap: 14px; }
  .hero-row .intro { flex-direction: column; align-items: flex-start; justify-content: center; gap: 14px; }
  .hero-cards :global(.acc) { align-content: start; }
  .hero-row .intro img { display: none; }
  @media (max-width: 1280px) {
    .hero-row { grid-template-columns: 1fr; }
    .hero-row .intro { order: -1; flex-direction: row; align-items: center; }
    .hero-row .intro img { display: block; width: 92px; height: 92px; }
    .hero-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .hero-row .intro { flex-direction: column; align-items: flex-start; }
    .hero-cards { grid-template-columns: 1fr; }
  }
</style>
