---
import Desktop from "../layouts/Desktop.astro";
import { faq } from "../data/faq";

const title = "FAQ — cl_audit: several Claude profiles and their usage limits on macOS";
const description =
  "Questions about cl_audit: profiles and accounts, Claude windows, the two switches on a dashboard card, why hiding the Dock icon restarts the Dock, where the usage figures come from, privacy, plans, requirements and version numbers.";
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
}];
---
<Desktop title={title} description={description} page="faq" headline="Common questions" jsonLd={jsonLd}>
  <div class="content-inner">
    <div class="faq-list">
      {faq.map(([q, a], i) => (
        <details class="card" open={i < 3}><summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
  </div>
</Desktop>
